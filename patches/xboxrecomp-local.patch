+static HANDLE        s_hi_event;          /* set per published frame */
+
+/* Each frame's emulated vblank, for the presenter's pacing (host ms on the
+ * QPC clock). The title's port pushes, on its own thread, the vblank of the
+ * tick each rendered frame belongs to (xbox_FrameVblankPush, once per
+ * present); the backend pops one per flip (xbox_FrameVblankPop) and
+ * publishes the frame with it. Taken at publish time instead, a frame whose
+ * render took about one period got the vblank before or after its own from
+ * frame to frame -- a period of judder in where it was aimed. One producer,
+ * one consumer: a full FIFO drops the new entry, an empty one gives 0. */
+static double s_hi_vbl[3];                 /* each buffer's frame's vblank, ms */
+static uint64_t s_hi_arr[3];               /* when each buffer's frame was published, ns */
+static double s_pub_vbl;                   /* set by xbox_FramebufferPublishImageVbl */
+
+void xbox_FramebufferPublishImageVbl(const uint32_t *px, uint32_t w, uint32_t h, double vblank_ms)
+{
+    extern void xbox_FramebufferPublishImage(const uint32_t *px, uint32_t w, uint32_t h);
+    s_pub_vbl = vblank_ms;
+    xbox_FramebufferPublishImage(px, w, h);
+    s_pub_vbl = 0.0;
+}
+
+void xbox_FramebufferPublishImage(const uint32_t *px, uint32_t w, uint32_t h)
+{
+    LONG b = s_hi_back;
+    size_t n = (size_t)w * h;
+    if (!s_fb_running || !px || !n)
+        return;
+    if (s_hi_cap[b] < n) {
+        free(s_hi[b]);
+        s_hi[b] = (uint32_t *)malloc(n * 4);
+        s_hi_cap[b] = s_hi[b] ? n : 0;
+        if (!s_hi[b])
+            return;
+    }
+    memcpy(s_hi[b], px, n * 4);
+    s_hi_w[b] = w; s_hi_h[b] = h;
+    s_hi_vbl[b] = s_pub_vbl;
+    s_hi_arr[b] = gpu_present_now_ns();
+    s_hi_back = InterlockedExchange(&s_hi_mid, b | 4) & 3;
+    InterlockedExchange(&s_hi_tick, (LONG)GetTickCount());
+    InterlockedIncrement(&s_hi_serial);
+    if (s_hi_event)
+        SetEvent(s_hi_event);
+}
