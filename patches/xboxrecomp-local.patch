+int xbox_FramebufferKeyDown(int vk)
+{
+    if ((unsigned)vk > 255)
+        return 0;
+    return s_key_down[vk] != 0;
+}
+
+int xbox_FramebufferKeyPresses(int vk)
+{
+    if ((unsigned)vk > 255)
+        return 0;
+    return __atomic_exchange_n(&s_key_presses[vk], 0, __ATOMIC_ACQ_REL);
+}
+
+/* SDL keycode -> Windows virtual-key code, for the keyboard pad stand-in. */
+static int sdl_to_vk(SDL_Keycode k)
+{
+    if (k >= 'a' && k <= 'z') return k - 'a' + 0x41;
+    if (k >= '0' && k <= '9') return k;
+    if (k >= SDLK_F1 && k <= SDLK_F12) return 0x70 + (k - SDLK_F1);
+    if (k >= SDLK_KP_1 && k <= SDLK_KP_9) return 0x61 + (k - SDLK_KP_1);
+    switch (k) {
+    case SDLK_KP_0: return 0x60;
+    case SDLK_RETURN: return 0x0D;   case SDLK_ESCAPE: return 0x1B;
+    case SDLK_SPACE: return 0x20;    case SDLK_TAB: return 0x09;
+    case SDLK_BACKSPACE: return 0x08;
+    case SDLK_LEFT: return 0x25;     case SDLK_UP: return 0x26;
+    case SDLK_RIGHT: return 0x27;    case SDLK_DOWN: return 0x28;
+    case SDLK_LSHIFT: case SDLK_RSHIFT: return 0x10;
+    case SDLK_LCTRL: case SDLK_RCTRL: return 0x11;
+    case SDLK_LALT: case SDLK_RALT: return 0x12;
+    case SDLK_COMMA: return 0xBC;    case SDLK_PERIOD: return 0xBE;
+    case SDLK_MINUS: return 0xBD;    case SDLK_EQUALS: return 0xBB;
+    case SDLK_DELETE: return 0x2E;   case SDLK_HOME: return 0x24;
+    case SDLK_END: return 0x23;      case SDLK_PAGEUP: return 0x21;
+    case SDLK_PAGEDOWN: return 0x22; case SDLK_INSERT: return 0x2D;
+    default: return 0;
+    }
+}
+
+static int s_dump_quiet;
+
+/* px: w*h pixels, 0xAARRGGBB, top row first. */
+static int write_bmp(const char *path, const uint32_t *px, uint32_t w, uint32_t h)
+{
+    FILE *f;
+    uint32_t row = ((w * 3u) + 3u) & ~3u;
+    uint32_t img = row * h, total = 54u + img, y, x;
+    uint8_t hdr[54], *line;
+
+    f = fopen(path, "wb");
+    if (!f)
+        return -1;
+    memset(hdr, 0, sizeof(hdr));
+    hdr[0] = 'B'; hdr[1] = 'M';
+    memcpy(hdr + 2, &total, 4);
+    hdr[10] = 54; hdr[14] = 40;
+    memcpy(hdr + 18, &w, 4);
+    memcpy(hdr + 22, &h, 4);
+    hdr[26] = 1; hdr[28] = 24;
+    memcpy(hdr + 34, &img, 4);
+    fwrite(hdr, 1, sizeof(hdr), f);
+    line = (uint8_t *)calloc(1, row);
+    for (y = 0; y < h; y++) {
+        const uint32_t *src = px + (size_t)(h - 1 - y) * w;
+        for (x = 0; x < w; x++) {
+            line[x * 3 + 0] = (uint8_t)(src[x] & 0xFF);
+            line[x * 3 + 1] = (uint8_t)((src[x] >> 8) & 0xFF);
+            line[x * 3 + 2] = (uint8_t)((src[x] >> 16) & 0xFF);
+        }
+        fwrite(line, 1, row, f);
+    }
+    free(line);
+    fclose(f);
+    return 0;
+}
+
+int xbox_FramebufferDumpBmp(const char *path)
+{
+    if (!s_rgb || !s_fb_va)
+        return -1;
+    if (write_bmp(path, s_rgb, s_fb_width, s_fb_height))
+        return -1;
+    if (!s_dump_quiet)
+        fprintf(stderr, "  [FBWIN] wrote %s (%ux%u from 0x%08X)\n",
+                path, s_fb_width, s_fb_height, s_fb_va);
+    return 0;
+}
+
+/* RECOMP_SNAP_TRIGGER=<file>: when it appears, dump the shown frame to the BMP
+ * path it contains and delete it. hi: the GPU backend's full-resolution frame
+ * when that is what the window shows (s_rgb is not updated then). */
+static void snap_trigger_poll(const uint32_t *hi, uint32_t hi_w, uint32_t hi_h)
+{
+    (void)hi; (void)hi_w; (void)hi_h;   /* the published frame (s_hi) is used */
+    static int checked;
+    static const char *trig;
+    FILE *f;
+    char path[1024];
+    size_t n;
+
+    if (!checked) {
+        checked = 1;
+        trig = getenv("RECOMP_SNAP_TRIGGER");
+    }
+    if (!trig || access(trig, F_OK) != 0)
+        return;
+    f = fopen(trig, "rb");
+    if (!f)
+        return;
+    n = fread(path, 1, sizeof path - 1, f);
+    fclose(f);
+    while (n && (path[n - 1] == '\n' || path[n - 1] == '\r' || path[n - 1] == ' '))
+        n--;
+    path[n] = 0;
+    unlink(trig);
+    if (!n)
+        return;
+    xbox_FramebufferSnapshot(path);
+}
+
+void xbox_FramebufferSnapshot(const char *path)
+{
+    /* The image the window shows: a renderer's published frame (Vulkan, at
+     * the internal resolution and in widescreen) when there is a current
+     * one, else the guest framebuffer, which that renderer leaves unused. */
+    pthread_mutex_lock(&s_hi_lock);
+    if (s_hi && now_ms() - s_hi_at < 250.0) {
+        write_bmp(path, s_hi, s_hi_w, s_hi_h);
+        pthread_mutex_unlock(&s_hi_lock);
+        return;
+    }
+    pthread_mutex_unlock(&s_hi_lock);
+    s_dump_quiet = 1;
+    xbox_FramebufferDumpBmp(path);
+    s_dump_quiet = 0;
+}
+
+static void *fb_thread(void *unused)
+{
+    SDL_Window *win;
+    SDL_Renderer *ren;
+    SDL_Texture *tex, *hi_tex = NULL;
+    uint32_t *hi_rgb = NULL, hi_w = 0, hi_h = 0;
+    double t0 = 0;
+    int f0 = 0;
+
+    (void)unused;
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO) != 0) {
+        fprintf(stderr, "  [FBWIN] SDL video init failed: %s\n", SDL_GetError());
+        s_fb_running = 0;
+        return NULL;
+    }
+    win = SDL_CreateWindow("Xbox Recomp - Framebuffer",
+                           SDL_WINDOWPOS_UNDEFINED, SDL_WINDOWPOS_UNDEFINED,
+                           (int)s_fb_width, (int)s_fb_height,
+                           SDL_WINDOW_SHOWN | SDL_WINDOW_RESIZABLE);
+    ren = win ? SDL_CreateRenderer(win, -1, SDL_RENDERER_PRESENTVSYNC) : NULL;
+    tex = ren ? SDL_CreateTexture(ren, SDL_PIXELFORMAT_ARGB8888,
+                                  SDL_TEXTUREACCESS_STREAMING,
+                                  (int)s_fb_width, (int)s_fb_height) : NULL;
+    if (!tex) {
+        fprintf(stderr, "  [FBWIN] window setup failed: %s\n", SDL_GetError());
+        s_fb_running = 0;
+        return NULL;
+    }
+    SDL_RenderSetLogicalSize(ren, (int)s_fb_width, (int)s_fb_height);
+    s_rgb = (uint32_t *)calloc((size_t)s_fb_width * s_fb_height, 4);
+    fprintf(stderr, "  [FBWIN] framebuffer window open (%ux%u)\n",
+            s_fb_width, s_fb_height);
+
+    while (s_fb_running) {
+        SDL_Event e;
+        int idx;
+
+        while (SDL_PollEvent(&e)) {
+            if (e.type == SDL_QUIT) {
+                /* Window close, and SDL turns SIGINT/SIGTERM into this too.
+                 * Closing only the window left the game running and the
+                 * next flip reopened it. */
+                fflush(NULL);
+                _exit(0);
+            } else if (e.type == SDL_KEYDOWN || e.type == SDL_KEYUP) {
+                int vk = sdl_to_vk(e.key.keysym.sym);
+                /* RECOMP_KEY_TRACE: each key as it arrives, as in fb_present.c,
+                 * with SDL's name for it -- tells "never reached the window"
+                 * (a desktop shortcut or media key) from "arrived unmapped". */
+                {
+                    static int trace = -1, n;
+                    if (trace < 0)
+                        trace = getenv("RECOMP_KEY_TRACE") != NULL;
+                    if (trace && e.type == SDL_KEYDOWN && !e.key.repeat && n++ < 200) {
+                        fprintf(stderr, "  [KEY] down %s (sym 0x%X) vk=0x%02X\n",
+                                SDL_GetKeyName(e.key.keysym.sym), (unsigned)e.key.keysym.sym, vk);
+                        fflush(stderr);
+                    }
+                }
+                if (vk) {
+                    s_key_down[vk] = e.type == SDL_KEYDOWN;
+                    if (e.type == SDL_KEYDOWN && !e.key.repeat)
+                        __atomic_add_fetch(&s_key_presses[vk], 1, __ATOMIC_RELEASE);
+                }
+            } else if (e.type == SDL_WINDOWEVENT &&
+                       e.window.event == SDL_WINDOWEVENT_FOCUS_LOST) {
+                memset((void *)s_key_down, 0, sizeof s_key_down);
+                fprintf(stderr, "[FBWIN] focus lost\n");
+            } else if (e.type == SDL_WINDOWEVENT &&
+                       e.window.event == SDL_WINDOWEVENT_FOCUS_GAINED) {
+                fprintf(stderr, "[FBWIN] focus gained\n");
+            }
+        }
+        if (!(SDL_GetWindowFlags(win) & SDL_WINDOW_MINIMIZED)) {
+            int cw, ch;
+            SDL_GetWindowSize(win, &cw, &ch);
+            __atomic_store_n(&s_client_w, cw, __ATOMIC_RELAXED);
+            __atomic_store_n(&s_client_h, ch, __ATOMIC_RELAXED);
+        }
+        pthread_mutex_lock(&s_hi_lock);
+        if (s_hi && now_ms() - s_hi_at < 250.0) {
+            int fresh = s_hi_new;
+            if (s_hi_w != hi_w || s_hi_h != hi_h) {
+                if (hi_tex) SDL_DestroyTexture(hi_tex);
+                free(hi_rgb);
+                hi_w = s_hi_w; hi_h = s_hi_h;
+                hi_rgb = (uint32_t *)malloc((size_t)hi_w * hi_h * 4);
+                hi_tex = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ARGB8888,
+                                           SDL_TEXTUREACCESS_STREAMING, (int)hi_w, (int)hi_h);
+                SDL_RenderSetLogicalSize(ren, (int)hi_w, (int)hi_h);
+                fresh = 1;
+            }
+            if (fresh && hi_rgb)
+                memcpy(hi_rgb, s_hi, (size_t)hi_w * hi_h * 4);
+            s_hi_new = 0;
+            pthread_mutex_unlock(&s_hi_lock);
+            if (hi_tex && hi_rgb) {
+                if (fresh) {
+                    xbox_FramebufferApplyGamma(hi_rgb, (size_t)hi_w * hi_h);
+                    SDL_UpdateTexture(hi_tex, NULL, hi_rgb, (int)(hi_w * 4));
+                }
+                SDL_RenderClear(ren);
+                SDL_RenderCopy(ren, hi_tex, NULL, NULL);
+                SDL_RenderPresent(ren);
+                snap_trigger_poll(hi_rgb, hi_w, hi_h);
+                goto shown;
+            }
+        } else {
+            pthread_mutex_unlock(&s_hi_lock);
+            if (hi_tex) {
+                SDL_DestroyTexture(hi_tex);
+                hi_tex = NULL;
+                hi_w = hi_h = 0;
+                SDL_RenderSetLogicalSize(ren, (int)s_fb_width, (int)s_fb_height);
+            }
+        }
+        idx = __atomic_load_n(&s_present_idx, __ATOMIC_ACQUIRE);
+        if (idx >= 0 && s_present[idx])
+            memcpy(s_rgb, s_present[idx], (size_t)s_fb_width * s_fb_height * 4);
+        else if (s_fb_va && s_fb_pitch) {
+            const uint8_t *src = (const uint8_t *)((uintptr_t)s_fb_va + xbox_GetMemoryOffset());
+            uint32_t y;
+            for (y = 0; y < s_fb_height; y++)
+                fb_convert_row(src + (size_t)y * s_fb_pitch,
+                               s_rgb + (size_t)y * s_fb_width,
+                               s_fb_pitch / s_fb_width);
+        }
+        xbox_FramebufferApplyGamma(s_rgb, (size_t)s_fb_width * s_fb_height);
+        SDL_UpdateTexture(tex, NULL, s_rgb, (int)(s_fb_width * 4));
+        SDL_RenderClear(ren);
+        SDL_RenderCopy(ren, tex, NULL, NULL);
+        SDL_RenderPresent(ren);
+        snap_trigger_poll(NULL, 0, 0);
+shown:
+        {
+            double now = now_ms();
+            if (now - t0 >= 1000.0) {
+                int f = s_flips;
+                char tb[128];
+                snprintf(tb, sizeof tb, "%s | FPS: %.1f | draws: %d", s_title,
+                         t0 ? (f - f0) * 1000.0 / (now - t0) : 0.0, s_frame_draws);
+                SDL_SetWindowTitle(win, tb);
+                t0 = now; f0 = f;
+            }
+        }
+    }
+    if (hi_tex) SDL_DestroyTexture(hi_tex);
+    free(hi_rgb);
+    SDL_DestroyTexture(tex);
+    SDL_DestroyRenderer(ren);
+    SDL_DestroyWindow(win);
+    return NULL;
+}
+
+void xbox_FramebufferWindowStart(void)
+{
+    pthread_t th;
+
+    if (!getenv("RECOMP_FB_WINDOW"))
+        return;
+    if (__sync_val_compare_and_swap(&s_fb_running, 0, 1) != 0)
+        return;
+    if (pthread_create(&th, NULL, fb_thread, NULL) == 0)
+        pthread_detach(th);
+    else
+        s_fb_running = 0;
+}
+#endif /* !_WIN32 */
+
+/* The frame's emulated vblank is for the Windows presenter's pacing
+ * (fb_present.c); this presenter shows frames as they come. */
+void xbox_FramebufferPublishImageVbl(const uint32_t *px, uint32_t w, uint32_t h, double vblank_ms)
+{
+    (void)vblank_ms;
+    xbox_FramebufferPublishImage(px, w, h);
+}
+
+/* Frames shared on the GPU are the Windows presenter's (fb_present.c). */
+int xbox_FramebufferSharedMake(uint32_t w, uint32_t h, void *handles[4], uint8_t luid[8])
+{
+    (void)w; (void)h; (void)handles; (void)luid;
+    return 0;
+}
+
+void xbox_FramebufferPublishShared(int tex, uint32_t w, uint32_t h, double vblank_ms)
+{
+    (void)tex; (void)w; (void)h; (void)vblank_ms;
+}
diff --git a/src/video/fb_present_web.c b/src/video/fb_present_web.c
new file mode 100644
index 0000000..c52b589
--- /dev/null
+++ b/src/video/fb_present_web.c
@@ -0,0 +1,293 @@
+/**
+ * Browser counterpart of fb_present_sdl.c: the guest framebuffer for a page.
+ *
+ * There is no window thread. At each flip the executor converts the guest
+ * surface into one of two RGBA buffers (canvas byte order, gamma applied);
+ * the page's requestAnimationFrame loop asks web_frame() for the newest one
+ * and copies it into its canvas. Keys come from the page through web_key().
+ * Same contract otherwise: RECOMP_FB_WINDOW, frame stats, BMP dump,
+ * xbox_FramebufferKeyDown.
+ */
+#include <stdint.h>
+
+#if defined(__EMSCRIPTEN__)
+#include <emscripten.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stddef.h>
+#include <time.h>
+#include <unistd.h>
+void xbox_FramebufferApplyGamma(uint32_t *px, size_t n);   /* fb_gamma.c */
+extern void *xbox_GuestToHost(uint32_t va);                 /* xbox_memory_layout.c */
+
+static volatile int  s_fb_running;
+static uint32_t      s_fb_va, s_fb_pitch, s_fb_width = 640, s_fb_height = 480;
+static uint32_t     *s_present[2];
+static volatile int  s_present_idx = -1;
+static volatile uint32_t s_present_seq;
+static volatile unsigned char s_key_down[256];
+static char          s_title[48] = "Xbox Recomp";
+static volatile int  s_flips, s_frame_draws;
+static volatile int  s_client_w, s_client_h;
+
+int xbox_FramebufferClientSize(int *w, int *h)
+{
+    int cw = __atomic_load_n(&s_client_w, __ATOMIC_RELAXED);
+    int ch = __atomic_load_n(&s_client_h, __ATOMIC_RELAXED);
+    if (cw <= 0 || ch <= 0)
+        return 0;
+    *w = cw; *h = ch;
+    return 1;
+}
+
+void xbox_FramebufferWindowSet(uint32_t fb_va, uint32_t pitch)
+{
+    const char *pin = getenv("RECOMP_FB_VA");
+
+    s_fb_va = pin ? (uint32_t)strtoul(pin, NULL, 0) : fb_va;
+    if (pitch)
+        s_fb_pitch = pitch;
+}
+
+/* Guest row (X8R8G8B8 or R5G6B5) -> 0xAARRGGBB words. */
+static void fb_convert_row(const uint8_t *row, uint32_t *dst, uint32_t bpp)
+{
+    uint32_t x;
+
+    if (bpp == 4) {
+        memcpy(dst, row, (size_t)s_fb_width * 4);
+    } else if (bpp == 2) {
+        const uint16_t *p = (const uint16_t *)row;
+        for (x = 0; x < s_fb_width; x++) {
+            uint16_t v = p[x];
+            uint32_t r = (uint32_t)((v >> 11) & 0x1F) * 255u / 31u;
+            uint32_t g = (uint32_t)((v >>  5) & 0x3F) * 255u / 63u;
+            uint32_t b = (uint32_t)( v        & 0x1F) * 255u / 31u;
+            dst[x] = (r << 16) | (g << 8) | b;
+        }
+    } else {
+        memset(dst, 0, (size_t)s_fb_width * 4);
+    }
+}
+
+/* 0xAARRGGBB words -> R,G,B,255 bytes, the canvas's ImageData order. */
+static void to_canvas_order(uint32_t *px, size_t n)
+{
+    size_t i;
+    for (i = 0; i < n; i++) {
+        uint32_t v = px[i];
+        px[i] = 0xFF000000u | ((v & 0xFFu) << 16) | (v & 0xFF00u) | ((v >> 16) & 0xFFu);
+    }
+}
+
+void xbox_FramebufferPublishImage(const uint32_t *px, uint32_t w, uint32_t h)
+{
+    (void)px; (void)w; (void)h;
+}
+
+/* Called by the pushbuffer executor when the title flips. */
+void xbox_FramebufferWindowPresent(uint32_t fb_va, uint32_t pitch)
+{
+    const uint8_t *src;
+    int next;
+    uint32_t bpp, y;
+    size_t n = (size_t)s_fb_width * s_fb_height;
+
+    static int gpu = -1;
+
+    if (!s_fb_running || !fb_va || !pitch)
+        return;
+    if (gpu < 0)        /* the page's WebGPU renderer shows its frames itself */
+        gpu = getenv("RECOMP_WEBGPU") != NULL && !(getenv("RECOMP_GPU") && *getenv("RECOMP_GPU") == 's');
+    if (gpu || getenv("RECOMP_FB_VA"))
+        return;
+    next = (s_present_idx == 0) ? 1 : 0;
+    if (!s_present[next]) {
+        s_present[next] = (uint32_t *)calloc(n, 4);
+        if (!s_present[next])
+            return;
+    }
+    bpp = pitch / s_fb_width;
+    src = (const uint8_t *)xbox_GuestToHost(fb_va);
+    for (y = 0; y < s_fb_height; y++)
+        fb_convert_row(src + (size_t)y * pitch,
+                       s_present[next] + (size_t)y * s_fb_width, bpp);
+    xbox_FramebufferApplyGamma(s_present[next], n);
+    to_canvas_order(s_present[next], n);
+    __atomic_store_n(&s_present_idx, next, __ATOMIC_RELEASE);
+    __atomic_fetch_add(&s_present_seq, 1, __ATOMIC_RELEASE);
+}
+
+/* For the page, once per animation frame. Out: info[0..4] = width, height,
+ * frame sequence number, flips so far, draws in the last frame. In:
+ * info[6], info[7] = the canvas's display size. Returns the newest frame
+ * (RGBA bytes), or 0 before the first flip. */
+EMSCRIPTEN_KEEPALIVE uint32_t *web_frame(int32_t *info)
+{
+    int idx = __atomic_load_n(&s_present_idx, __ATOMIC_ACQUIRE);
+
+    info[0] = (int32_t)s_fb_width;
+    info[1] = (int32_t)s_fb_height;
+    info[2] = (int32_t)__atomic_load_n(&s_present_seq, __ATOMIC_ACQUIRE);
+    info[3] = s_flips;
+    info[4] = s_frame_draws;
+    if (info[6] > 0 && info[7] > 0) {
+        __atomic_store_n(&s_client_w, info[6], __ATOMIC_RELAXED);
+        __atomic_store_n(&s_client_h, info[7], __ATOMIC_RELAXED);
+    }
+    return idx >= 0 ? s_present[idx] : 0;
+}
+
+void xbox_FramebufferWindowSetTitle(const uint16_t *name, int max_chars)
+{
+    int i;
+
+    for (i = 0; i < max_chars && i < 47 && name[i]; i++)
+        s_title[i] = (char)name[i];
+    if (i)
+        s_title[i] = 0;
+}
+
+static double now_ms(void)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+static int cmp_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return x < y ? -1 : x > y;
+}
+
+/* RECOMP_FRAME_STATS=1: [FRAMES] line once a second, as on the other hosts. */
+void xbox_FramebufferWindowFrameStats(uint32_t draws)
+{
+    static int on = -1;
+    static double last, window, dt[2048];
+    static int n;
+    double t;
+
+    __atomic_fetch_add(&s_flips, 1, __ATOMIC_RELAXED);
+    s_frame_draws = (int)draws;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_FRAME_STATS");
+        on = e && *e && *e != '0';
+    }
+    if (!on)
+        return;
+    t = now_ms();
+    if (last && n < (int)(sizeof dt / sizeof dt[0]))
+        dt[n++] = t - last;
+    last = t;
+    if (!window)
+        window = t;
+    if (t - window >= 1000.0 && n) {
+        double secs = (t - window) / 1000.0;
+        qsort(dt, (size_t)n, sizeof dt[0], cmp_double);
+        fprintf(stderr, "[FRAMES] n %d fps %.1f p50 %.1f p99 %.1f max %.1f ms draws %u\n",
+                n, n / secs, dt[n / 2],
+                dt[(n * 99) / 100 < n ? (n * 99) / 100 : n - 1], dt[n - 1], draws);
+        n = 0;
+        window = t;
+    }
+}
+
+int xbox_FramebufferKeyDown(int vk)
+{
+    if ((unsigned)vk > 255)
+        return 0;
+    return s_key_down[vk] != 0;
+}
+
+/* Called from the page with a Windows virtual-key code (web/ maps
+ * KeyboardEvent.code); vk < 0 releases every key (focus lost). */
+EMSCRIPTEN_KEEPALIVE void web_key(int vk, int down)
+{
+    if (vk < 0) {
+        memset((void *)s_key_down, 0, sizeof s_key_down);
+        return;
+    }
+    if (vk < 256)
+        s_key_down[vk] = down != 0;
+}
+
+int xbox_FramebufferDumpBmp(const char *path)
+{
+    FILE *f;
+    uint32_t row = ((s_fb_width * 3u) + 3u) & ~3u;
+    uint32_t img = row * s_fb_height, total = 54u + img, y, x;
+    uint8_t hdr[54], *line;
+    int idx = __atomic_load_n(&s_present_idx, __ATOMIC_ACQUIRE);
+    const uint32_t *px;
+
+    if (idx < 0 || !s_present[idx])
+        return -1;
+    px = s_present[idx];
+    f = fopen(path, "wb");
+    if (!f)
+        return -1;
+    memset(hdr, 0, sizeof(hdr));
+    hdr[0] = 'B'; hdr[1] = 'M';
+    memcpy(hdr + 2, &total, 4);
+    hdr[10] = 54; hdr[14] = 40;
+    memcpy(hdr + 18, &s_fb_width, 4);
+    memcpy(hdr + 22, &s_fb_height, 4);
+    hdr[26] = 1; hdr[28] = 24;
+    memcpy(hdr + 34, &img, 4);
+    fwrite(hdr, 1, sizeof(hdr), f);
+    line = (uint8_t *)calloc(1, row);
+    for (y = 0; y < s_fb_height; y++) {
+        const uint32_t *src = px + (size_t)(s_fb_height - 1 - y) * s_fb_width;
+        for (x = 0; x < s_fb_width; x++) {          /* canvas order R,G,B,A */
+            line[x * 3 + 0] = (uint8_t)((src[x] >> 16) & 0xFF);
+            line[x * 3 + 1] = (uint8_t)((src[x] >> 8) & 0xFF);
+            line[x * 3 + 2] = (uint8_t)(src[x] & 0xFF);
+        }
+        fwrite(line, 1, row, f);
+    }
+    free(line);
+    fclose(f);
+    fprintf(stderr, "  [FBWIN] wrote %s (%ux%u from 0x%08X)\n",
+            path, s_fb_width, s_fb_height, s_fb_va);
+    return 0;
+}
+
+void xbox_FramebufferSnapshot(const char *path)
+{
+    xbox_FramebufferDumpBmp(path);
+}
+
+void xbox_FramebufferWindowStart(void)
+{
+    if (!getenv("RECOMP_FB_WINDOW"))
+        return;
+    if (__sync_val_compare_and_swap(&s_fb_running, 0, 1) != 0)
+        return;
+    fprintf(stderr, "  [FBWIN] presenting to the page (%ux%u)\n",
+            s_fb_width, s_fb_height);
+}
+#endif /* __EMSCRIPTEN__ */
+
+/* The frame's emulated vblank is for the Windows presenter's pacing
+ * (fb_present.c); this presenter shows frames as they come. */
+void xbox_FramebufferPublishImageVbl(const uint32_t *px, uint32_t w, uint32_t h, double vblank_ms)
+{
+    (void)vblank_ms;
+    xbox_FramebufferPublishImage(px, w, h);
+}
+
+/* Frames shared on the GPU are the Windows presenter's (fb_present.c). */
+int xbox_FramebufferSharedMake(uint32_t w, uint32_t h, void *handles[4], uint8_t luid[8])
+{
+    (void)w; (void)h; (void)handles; (void)luid;
+    return 0;
+}
+
+void xbox_FramebufferPublishShared(int tex, uint32_t w, uint32_t h, double vblank_ms)
+{
+    (void)tex; (void)w; (void)h; (void)vblank_ms;
+}
diff --git a/src/video/frame_vblank.c b/src/video/frame_vblank.c
new file mode 100644
index 0000000..5846d44
--- /dev/null
+++ b/src/video/frame_vblank.c
@@ -0,0 +1,43 @@
+/*
+ * frame_vblank.c - each frame's emulated vblank on its way to the
+ * presenter (vbl_fifo.h), on every platform: the title's port pushes it once
+ * per present, the renderer pops one per flip and publishes the frame with
+ * it (xbox_FramebufferPublishImageVbl). Only the Windows presenter paces
+ * frames by it; elsewhere the value is carried and unused.
+ */
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include "platform/win32_compat.h"
+#endif
+#include "vbl_fifo.h"
+
+static vbl_fifo s_vbl;
+
+/* The kernel's clock (kernel_bridge.c qpc_now_ms): QueryPerformanceCounter,
+ * which win32_compat maps to the monotonic clock off Windows. */
+static double now_ms(void)
+{
+    LARGE_INTEGER f, c;
+    QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart * 1000.0 / (double)f.QuadPart;
+}
+
+void xbox_FrameVblankPush(double ms)
+{
+    vbl_fifo_push(&s_vbl, ms);
+}
+
+/* The flipped frame's vblank; entries over 1.5 periods old are skipped
+ * while a newer one waits (presents that made no flip). */
+double xbox_FrameVblankPop(void)
+{
+    return vbl_fifo_pop(&s_vbl, now_ms(), 1.5 * 1000.0 / 60.0);
+}
+
+/* Drop what is queued (the backend found its entries stale). */
+void xbox_FrameVblankFlush(void)
+{
+    s_vbl.head = s_vbl.tail;
+}
diff --git a/src/video/gpu_present.c b/src/video/gpu_present.c
new file mode 100644
index 0000000..0e8f5a4
--- /dev/null
+++ b/src/video/gpu_present.c
@@ -0,0 +1,761 @@
+/*
+ * D3D11 presentation for the framebuffer window (ROADMAP Phase 2.1).
+ *
+ * The window used to show each frame with GDI (StretchDIBits on a 16 ms
+ * timer). This puts a D3D11 device and a swap chain on the same window and
+ * presents the flipped frame through it, vsync-paced. The frame (the guest's
+ * A8R8G8B8, i.e. B8G8R8A8 in memory order) is uploaded into its own texture
+ * and drawn into a back buffer the size of the window's client area,
+ * letterboxed to the frame's aspect ratio on black -- the window can be any
+ * size (or borderless fullscreen, fb_present.c) without stretching the
+ * picture. Linear filtering; RECOMP_PRESENT_FILTER=point for sharp pixels.
+ * RECOMP_D3D_PRESENT=0 keeps GDI; anything that fails falls back to it.
+ */
+#if defined(_WIN32)
+#define COBJMACROS
+#include <windows.h>
+#include <d3d11.h>
+#include <dxgi.h>
+#include <dxgi1_5.h>
+#include <dxgi1_2.h>
+#include <d3dcompiler.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "gpu_present.h"
+
+#pragma comment(lib, "d3d11.lib")
+#pragma comment(lib, "dxgi.lib")
+#pragma comment(lib, "dxguid.lib")
+#pragma comment(lib, "d3dcompiler.lib")
+
+static ID3D11Device             *s_dev;
+static ID3D11DeviceContext      *s_ctx;
+static IDXGISwapChain           *s_chain;
+/* Flip model (DXGI 1.2+): FLIP_DISCARD, three buffers, the frame-latency
+ * waitable object, and tearing allowed when the system supports it -- what
+ * variable refresh needs in a window and what keeps the compositor from
+ * adding a frame. 0 = the old blt-model DISCARD chain (fallback). */
+static int                       s_flip;
+static UINT                      s_chain_flags;  /* ResizeBuffers must repeat them */
+static int                       s_tearing;
+static HANDLE                    s_latency;      /* frame-latency waitable object */
+static LONGLONG                  s_qpc_freq;
+static ID3D11RenderTargetView   *s_rtv;
+static ID3D11Texture2D          *s_frame;      /* the guest frame, w x h */
+static ID3D11ShaderResourceView *s_srv;
+static ID3D11SamplerState       *s_samp;
+static ID3D11VertexShader       *s_vs;
+static ID3D11PixelShader        *s_ps;
+static ID3D11PixelShader        *s_ps_gamma;   /* + the title's gamma ramp */
+static ID3D11Texture2D          *s_lut;        /* 256 x 1, the ramp (fb_gamma.c) */
+static ID3D11ShaderResourceView *s_lut_srv;
+static unsigned                  s_lut_serial = ~0u;
+static char                      s_capture[MAX_PATH];  /* gpu_present_capture: pending */
+static volatile LONG             s_capture_pending;
+
+/* The next presented image (back buffer: letterbox, overlay and gamma
+ * included -- what the window shows) as a 24-bit BMP. RECOMP_SNAP_PRESENTED=1
+ * routes the snapshot trigger here (fb_present.c). */
+void gpu_present_capture(const char *path)
+{
+    strncpy(s_capture, path, sizeof s_capture - 1);
+    s_capture[sizeof s_capture - 1] = 0;
+    InterlockedExchange(&s_capture_pending, 1);
+}
+
+static void capture_back_buffer(void)
+{
+    ID3D11Texture2D *back = NULL, *stg = NULL;
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_MAPPED_SUBRESOURCE m;
+    FILE *f;
+    if (FAILED(IDXGISwapChain_GetBuffer(s_chain, 0, &IID_ID3D11Texture2D, (void **)&back)))
+        return;
+    ID3D11Texture2D_GetDesc(back, &td);
+    td.Usage = D3D11_USAGE_STAGING; td.BindFlags = 0; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    td.MiscFlags = 0;
+    if (SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &stg))) {
+        ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)stg, (ID3D11Resource *)back);
+        if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)stg, 0, D3D11_MAP_READ, 0, &m))) {
+            if ((f = fopen(s_capture, "wb")) != NULL) {
+                uint32_t row = (td.Width * 3u + 3u) & ~3u, img = row * td.Height, y, x;
+                uint8_t hdr[54] = {'B', 'M'}, *line = (uint8_t *)calloc(1, row);
+                uint32_t total = 54u + img;
+                memcpy(hdr + 2, &total, 4); hdr[10] = 54; hdr[14] = 40;
+                memcpy(hdr + 18, &td.Width, 4); memcpy(hdr + 22, &td.Height, 4);
+                hdr[26] = 1; hdr[28] = 24; memcpy(hdr + 34, &img, 4);
+                fwrite(hdr, 1, 54, f);
+                for (y = td.Height; line && y-- > 0;) {
+                    const uint8_t *src = (const uint8_t *)m.pData + (size_t)y * m.RowPitch;
+                    for (x = 0; x < td.Width; x++) {
+                        line[x * 3] = src[x * 4]; line[x * 3 + 1] = src[x * 4 + 1];
+                        line[x * 3 + 2] = src[x * 4 + 2];
+                    }
+                    fwrite(line, 1, row, f);
+                }
+                free(line);
+                fclose(f);
+            }
+            ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)stg, 0);
+        }
+        ID3D11Texture2D_Release(stg);
+    }
+    ID3D11Texture2D_Release(back);
+}
+static HWND                      s_hwnd;
+static uint32_t                  s_w, s_h;      /* frame size */
+static uint32_t                  s_bw, s_bh;    /* back buffer (client) size */
+static int                       s_vsync = 1;
+
+/* A triangle covering the viewport, from the vertex id; uv 0..1. */
+static const char s_hlsl[] =
+    "Texture2D t : register(t0); SamplerState s : register(s0);\n"
+    "struct V { float4 p : SV_Position; float2 uv : TEXCOORD0; };\n"
+    "V vs(uint i : SV_VertexID) { V o; float2 q = float2((i << 1) & 2, i & 2);\n"
+    "  o.uv = q; o.p = float4(q * float2(2, -2) + float2(-1, 1), 0, 1); return o; }\n"
+    "float4 ps(V i) : SV_Target { return float4(t.Sample(s, i.uv).rgb, 1); }\n"
+    "Texture2D lut : register(t1);\n"
+    "float4 psg(V i) : SV_Target { int3 c = int3(saturate(t.Sample(s, i.uv).rgb) * 255.0 + 0.5);\n"
+    "  return float4(lut.Load(int3(c.r, 0, 0)).r, lut.Load(int3(c.g, 0, 0)).g,\n"
+    "                lut.Load(int3(c.b, 0, 0)).b, 1); }\n";
+
+int gpu_present_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_D3D_PRESENT");
+        on = e && *e && *e != '0';
+    }
+    return on;
+}
+
+static void client_size(uint32_t *w, uint32_t *h)
+{
+    RECT r;
+    GetClientRect(s_hwnd, &r);
+    *w = r.right > r.left ? (uint32_t)(r.right - r.left) : 1;
+    *h = r.bottom > r.top ? (uint32_t)(r.bottom - r.top) : 1;
+}
+
+static int make_rtv(void)
+{
+    ID3D11Texture2D *back = NULL;
+    HRESULT hr = IDXGISwapChain_GetBuffer(s_chain, 0, &IID_ID3D11Texture2D, (void **)&back);
+    if (FAILED(hr))
+        return 0;
+    hr = ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)back, NULL, &s_rtv);
+    ID3D11Texture2D_Release(back);
+    return SUCCEEDED(hr);
+}
+
+static ID3DBlob *compile(const char *entry, const char *target)
+{
+    ID3DBlob *code = NULL, *err = NULL;
+    HRESULT hr = D3DCompile(s_hlsl, sizeof s_hlsl - 1, "present", NULL, NULL, entry, target,
+                            0, 0, &code, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "  [D3D] present shader %s: %s\n", entry,
+                err ? (const char *)ID3D10Blob_GetBufferPointer(err) : "failed");
+        if (err) ID3D10Blob_Release(err);
+        return NULL;
+    }
+    if (err) ID3D10Blob_Release(err);
+    return code;
+}
+
+/* The device, then a flip-model swap chain on hwnd. 1 on success; on any
+ * failure everything made here is released and 0 returned (the caller then
+ * makes the old chain). */
+static int create_flip_chain(HWND hwnd)
+{
+    IDXGIDevice *dd = NULL;
+    IDXGIAdapter *ad = NULL;
+    IDXGIFactory2 *f2 = NULL;
+    IDXGIFactory5 *f5 = NULL;
+    IDXGISwapChain1 *sc1 = NULL;
+    IDXGISwapChain2 *sc2 = NULL;
+    DXGI_SWAP_CHAIN_DESC1 d;
+    BOOL tear = FALSE;
+    HRESULT hr;
+
+    hr = D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL, 0, NULL, 0,
+                           D3D11_SDK_VERSION, &s_dev, NULL, &s_ctx);
+    if (FAILED(hr))
+        goto fail;
+    if (FAILED(ID3D11Device_QueryInterface(s_dev, &IID_IDXGIDevice, (void **)&dd))
+        || FAILED(IDXGIDevice_GetAdapter(dd, &ad))
+        || FAILED(IDXGIAdapter_GetParent(ad, &IID_IDXGIFactory2, (void **)&f2)))
+        goto fail;
+    if (SUCCEEDED(IDXGIFactory2_QueryInterface(f2, &IID_IDXGIFactory5, (void **)&f5))) {
+        if (FAILED(IDXGIFactory5_CheckFeatureSupport(f5, DXGI_FEATURE_PRESENT_ALLOW_TEARING,
+                                                     &tear, sizeof tear)))
+            tear = FALSE;
+        IDXGIFactory5_Release(f5);
+    }
+    ZeroMemory(&d, sizeof d);
+    d.Width = s_bw; d.Height = s_bh;
+    d.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    d.SampleDesc.Count = 1;
+    d.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    d.BufferCount = 3;
+    d.Scaling = DXGI_SCALING_NONE;
+    d.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    d.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+    d.Flags = DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT
+            | (tear ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0);
+    hr = IDXGIFactory2_CreateSwapChainForHwnd(f2, (IUnknown *)s_dev, hwnd, &d, NULL, NULL, &sc1);
+    if (FAILED(hr)) {
+        fprintf(stderr, "  [D3D] flip-model swap chain failed (0x%08lX); using the old one\n",
+                (unsigned long)hr);
+        goto fail;
+    }
+    if (SUCCEEDED(IDXGISwapChain1_QueryInterface(sc1, &IID_IDXGISwapChain2, (void **)&sc2))) {
+        IDXGISwapChain2_SetMaximumFrameLatency(sc2, 1);
+        s_latency = IDXGISwapChain2_GetFrameLatencyWaitableObject(sc2);
+        IDXGISwapChain2_Release(sc2);
+    }
+    s_chain = (IDXGISwapChain *)sc1;
+    s_chain_flags = d.Flags;
+    s_tearing = tear;
+    IDXGIFactory2_Release(f2);
+    IDXGIAdapter_Release(ad);
+    IDXGIDevice_Release(dd);
+    fprintf(stderr, "  [D3D] flip model, 3 buffers, frame latency 1%s\n",
+            tear ? ", tearing allowed (VRR in a window)" : "");
+    return 1;
+fail:
+    if (f2) IDXGIFactory2_Release(f2);
+    if (ad) IDXGIAdapter_Release(ad);
+    if (dd) IDXGIDevice_Release(dd);
+    if (s_ctx) { ID3D11DeviceContext_Release(s_ctx); s_ctx = NULL; }
+    if (s_dev) { ID3D11Device_Release(s_dev); s_dev = NULL; }
+    return 0;
+}
+
+int gpu_present_init(HWND hwnd, uint32_t width, uint32_t height)
+{
+    DXGI_SWAP_CHAIN_DESC sd;
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_SAMPLER_DESC smp;
+    ID3DBlob *vsb, *psb;
+    HRESULT hr;
+    const char *v = getenv("RECOMP_VSYNC"), *f = getenv("RECOMP_PRESENT_FILTER");
+
+    if (v && v[0] == '0')
+        s_vsync = 0;
+    s_hwnd = hwnd;
+    s_w = width; s_h = height;
+    client_size(&s_bw, &s_bh);
+    {
+        LARGE_INTEGER qf;
+        QueryPerformanceFrequency(&qf);
+        s_qpc_freq = qf.QuadPart;
+    }
+    if (!getenv("RECOMP_PRESENT_FLIP") || getenv("RECOMP_PRESENT_FLIP")[0] != '0')
+        s_flip = create_flip_chain(hwnd);
+    if (!s_flip) {
+        ZeroMemory(&sd, sizeof sd);
+        sd.BufferDesc.Width  = s_bw;
+        sd.BufferDesc.Height = s_bh;
+        sd.BufferDesc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+        sd.SampleDesc.Count  = 1;
+        sd.BufferUsage       = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+        sd.BufferCount       = 1;
+        sd.OutputWindow      = hwnd;
+        sd.Windowed          = TRUE;
+        sd.SwapEffect        = DXGI_SWAP_EFFECT_DISCARD;
+        s_chain_flags = 0;
+
+        hr = D3D11CreateDeviceAndSwapChain(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL, 0,
+                                           NULL, 0, D3D11_SDK_VERSION, &sd,
+                                           &s_chain, &s_dev, NULL, &s_ctx);
+        if (FAILED(hr)) {
+            fprintf(stderr, "  [D3D] device/swap chain failed (0x%08lX); staying on GDI\n",
+                    (unsigned long)hr);
+            return 0;
+        }
+    }
+    {
+        /* Alt+Enter is the window's (borderless fullscreen, fb_present.c),
+         * not DXGI's exclusive mode at 640x480. */
+        IDXGIFactory *fac = NULL;
+        if (SUCCEEDED(IDXGISwapChain_GetParent(s_chain, &IID_IDXGIFactory, (void **)&fac))) {
+            IDXGIFactory_MakeWindowAssociation(fac, hwnd, DXGI_MWA_NO_ALT_ENTER);
+            IDXGIFactory_Release(fac);
+        }
+    }
+    ZeroMemory(&td, sizeof td);
+    td.Width = width; td.Height = height; td.MipLevels = 1; td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM; td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_DEFAULT; td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    ZeroMemory(&smp, sizeof smp);
+    smp.Filter = (f && (f[0] == 'p' || f[0] == 'P')) ? D3D11_FILTER_MIN_MAG_MIP_POINT
+                                                     : D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+    smp.AddressU = smp.AddressV = smp.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    smp.MaxLOD = D3D11_FLOAT32_MAX;
+    vsb = compile("vs", "vs_4_0");
+    psb = compile("ps", "ps_4_0");
+    {
+        ID3DBlob *pgb = compile("psg", "ps_4_0");
+        D3D11_TEXTURE2D_DESC ld;
+        ZeroMemory(&ld, sizeof ld);
+        ld.Width = 256; ld.Height = 1; ld.MipLevels = 1; ld.ArraySize = 1;
+        ld.Format = DXGI_FORMAT_B8G8R8A8_UNORM; ld.SampleDesc.Count = 1;
+        ld.Usage = D3D11_USAGE_DEFAULT; ld.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        if (!pgb
+            || FAILED(ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(pgb),
+                                                     ID3D10Blob_GetBufferSize(pgb), NULL, &s_ps_gamma))
+            || FAILED(ID3D11Device_CreateTexture2D(s_dev, &ld, NULL, &s_lut))
+            || FAILED(ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)s_lut, NULL, &s_lut_srv))) {
+            /* no GPU gamma: gpu_present_frame_gamma falls back to the CPU */
+            if (s_ps_gamma) { ID3D11PixelShader_Release(s_ps_gamma); s_ps_gamma = NULL; }
+            if (s_lut_srv) { ID3D11ShaderResourceView_Release(s_lut_srv); s_lut_srv = NULL; }
+            if (s_lut) { ID3D11Texture2D_Release(s_lut); s_lut = NULL; }
+        }
+        if (pgb) ID3D10Blob_Release(pgb);
+    }
+    if (!vsb || !psb || !make_rtv()
+        || FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &s_frame))
+        || FAILED(ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)s_frame, NULL, &s_srv))
+        || FAILED(ID3D11Device_CreateSamplerState(s_dev, &smp, &s_samp))
+        || FAILED(ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(vsb),
+                                                  ID3D10Blob_GetBufferSize(vsb), NULL, &s_vs))
+        || FAILED(ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(psb),
+                                                 ID3D10Blob_GetBufferSize(psb), NULL, &s_ps))) {
+        fprintf(stderr, "  [D3D] present resources failed; staying on GDI\n");
+        if (vsb) ID3D10Blob_Release(vsb);
+        if (psb) ID3D10Blob_Release(psb);
+        gpu_present_shutdown();
+        return 0;
+    }
+    ID3D10Blob_Release(vsb);
+    ID3D10Blob_Release(psb);
+    fprintf(stderr, "  [D3D] presenting through D3D11 (%ux%u frame, vsync %s, %s filter)\n",
+            width, height, s_vsync ? "on" : "off",
+            smp.Filter == D3D11_FILTER_MIN_MAG_MIP_POINT ? "point" : "linear");
+    return 1;
+}
+
+/* A frame of another size (the renderer's own, higher-resolution image):
+ * the texture is recreated at that size first. */
+static int present_draw(const uint32_t *pixels, int gamma);
+
+static uint64_t s_present_at_ns;   /* gpu_present_frame_at: hand over at this time */
+/* Where the last present's time went, ms: the frame-latency wait, the
+ * upload and draw, the wait for its aimed time, the Present call. */
+static double s_step_ms[5];   /* [4]: a shared frame's keyed-mutex wait */
+
+void gpu_present_last_steps(double out[5])
+{
+    int i;
+    for (i = 0; i < 5; i++)
+        out[i] = s_step_ms[i];
+}
+
+uint64_t gpu_present_now_ns(void)
+{
+    LARGE_INTEGER c;
+    QueryPerformanceCounter(&c);
+    return (uint64_t)((double)c.QuadPart * 1e9 / (double)s_qpc_freq);
+}
+
+/* A high-resolution timer to half a millisecond before, then a spin. */
+static void wait_until_ns(uint64_t at_ns)
+{
+    static HANDLE timer;
+    uint64_t now = gpu_present_now_ns();
+    if (at_ns <= now)
+        return;
+    if (at_ns - now > 1000000ull) {
+        if (!timer)
+            timer = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* HIGH_RESOLUTION */,
+                                           TIMER_ALL_ACCESS);
+        if (timer) {
+            LARGE_INTEGER due;
+            due.QuadPart = -(LONGLONG)((at_ns - now - 500000ull) / 100ull);
+            if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE))
+                WaitForSingleObject(timer, INFINITE);
+        } else {
+            Sleep((DWORD)((at_ns - now) / 1000000ull) - 1);
+        }
+    }
+    while (gpu_present_now_ns() < at_ns)
+        YieldProcessor();
+}
+
+int gpu_present_frame_at(const uint32_t *pixels, uint32_t width, uint32_t height,
+                         int gamma, uint64_t at_ns)
+{
+    int r;
+    s_present_at_ns = at_ns;
+    r = gpu_present_frame_gamma(pixels, width, height, gamma);
+    s_present_at_ns = 0;
+    return r;
+}
+
+int gpu_present_glass(uint32_t *present_count, uint64_t *glass_ns)
+{
+    DXGI_FRAME_STATISTICS st;
+    if (!s_chain || !s_flip || FAILED(IDXGISwapChain_GetFrameStatistics(s_chain, &st))
+        || !st.SyncQPCTime.QuadPart)
+        return 0;
+    *present_count = st.PresentCount;
+    *glass_ns = (uint64_t)((double)st.SyncQPCTime.QuadPart * 1e9 / (double)s_qpc_freq);
+    return 1;
+}
+
+uint32_t gpu_present_last_count(void)
+{
+    UINT n = 0;
+    if (s_chain && s_flip)
+        IDXGISwapChain_GetLastPresentCount(s_chain, &n);
+    return n;
+}
+
+int gpu_present_flip_model(void)
+{
+    return s_flip;
+}
+
+int gpu_present_frame_size(const uint32_t *pixels, uint32_t width, uint32_t height)
+{
+    return gpu_present_frame_gamma(pixels, width, height, 0);
+}
+
+/* gamma: apply the title's ramp (fb_gamma.c) in the shader -- for frames
+ * the caller has not already put through xbox_FramebufferApplyGamma. The
+ * pixels are read before this returns. */
+int gpu_present_frame_gamma(const uint32_t *pixels, uint32_t width, uint32_t height, int gamma)
+{
+    if (!s_dev || !width || !height)
+        return 0;
+    if (width != s_w || height != s_h) {
+        D3D11_TEXTURE2D_DESC td;
+        if (s_srv)   { ID3D11ShaderResourceView_Release(s_srv); s_srv = NULL; }
+        if (s_frame) { ID3D11Texture2D_Release(s_frame);        s_frame = NULL; }
+        ZeroMemory(&td, sizeof td);
+        td.Width = width; td.Height = height; td.MipLevels = 1; td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_B8G8R8A8_UNORM; td.SampleDesc.Count = 1;
+        td.Usage = D3D11_USAGE_DEFAULT; td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &s_frame))
+            || FAILED(ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)s_frame, NULL, &s_srv)))
+            return 0;
+        s_w = width; s_h = height;
+        fprintf(stderr, "  [D3D] frame size now %ux%u\n", width, height);
+    }
+    if (gamma && !s_ps_gamma) {
+        /* no GPU gamma: the CPU pass on a copy (the pixels are the caller's) */
+        extern void xbox_FramebufferApplyGamma(uint32_t *px, size_t n);
+        static uint32_t *tmp;
+        static size_t cap;
+        size_t n = (size_t)width * height;
+        if (cap < n) { free(tmp); tmp = (uint32_t *)malloc(n * 4); cap = tmp ? n : 0; }
+        if (!tmp)
+            return 0;
+        memcpy(tmp, pixels, n * 4);
+        xbox_FramebufferApplyGamma(tmp, n);
+        return present_draw(tmp, 0);
+    }
+    if (gamma) {
+        extern unsigned xbox_FramebufferGammaSerial(void);
+        extern unsigned xbox_FramebufferGammaTexels(uint32_t *out256);
+        if (xbox_FramebufferGammaSerial() != s_lut_serial) {
+            uint32_t t[256];
+            s_lut_serial = xbox_FramebufferGammaTexels(t);
+            ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)s_lut, 0, NULL, t, 1024, 0);
+        }
+    }
+    return present_draw(pixels, gamma);
+}
+
+int gpu_present_frame(const uint32_t *pixels)
+{
+    return present_draw(pixels, 0);
+}
+
+/* Returns 0 when nothing was shown: the window is occluded or the display
+ * is off, and Present does not wait for vsync then -- the caller must pace
+ * itself instead of spinning. */
+/* The overlay box for the next draw (the F3 counter on a shared frame):
+ * pixels, size and place in frame pixels; 0 x 0 = none. */
+static ID3D11Texture2D          *s_ovl_tex;
+static ID3D11ShaderResourceView *s_ovl_srv;
+static uint32_t                  s_ovl_cap_w, s_ovl_cap_h;
+static const uint32_t           *s_ovl_px;
+static uint32_t                  s_ovl_w, s_ovl_h, s_ovl_x, s_ovl_y;
+
+/* Draw srv (a w x h frame) letterboxed into the back buffer, the overlay
+ * box over it, then wait for the aimed time and present. pixels, when not
+ * NULL, are uploaded into srv's texture (s_frame) first. */
+static int present_srv(ID3D11ShaderResourceView *srv, uint32_t w, uint32_t h,
+                       const uint32_t *pixels, int gamma)
+{
+    static const float black[4] = {0, 0, 0, 1};
+    D3D11_VIEWPORT vp;
+    uint32_t cw, ch;
+    float sx, sy, sc;
+    uint64_t t0, t1, t2, t3;
+
+    if (!s_rtv || !srv)
+        return 0;
+    t0 = gpu_present_now_ns();
+    if (s_latency)
+        WaitForSingleObjectEx(s_latency, 100, TRUE);
+    t1 = gpu_present_now_ns();
+    s_step_ms[0] = (double)(t1 - t0) / 1e6;
+    client_size(&cw, &ch);
+    if (cw != s_bw || ch != s_bh) {
+        /* The window was resized (or went fullscreen): a back buffer its size. */
+        ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 0, NULL, NULL);
+        ID3D11RenderTargetView_Release(s_rtv);
+        s_rtv = NULL;
+        if (FAILED(IDXGISwapChain_ResizeBuffers(s_chain, 0, cw, ch, DXGI_FORMAT_UNKNOWN, s_chain_flags))
+            || !make_rtv())
+            return 0;
+        s_bw = cw; s_bh = ch;
+    }
+    if (pixels)
+        ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)s_frame, 0, NULL,
+                                              pixels, w * 4, 0);
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 1, &s_rtv, NULL);
+    ID3D11DeviceContext_ClearRenderTargetView(s_ctx, s_rtv, black);
+    /* The largest rectangle of the frame's shape that fits, centred. */
+    sx = (float)s_bw / (float)w;
+    sy = (float)s_bh / (float)h;
+    sc = sx < sy ? sx : sy;
+    vp.Width = (float)w * sc;
+    vp.Height = (float)h * sc;
+    vp.TopLeftX = ((float)s_bw - vp.Width) * 0.5f;
+    vp.TopLeftY = ((float)s_bh - vp.Height) * 0.5f;
+    vp.MinDepth = 0; vp.MaxDepth = 1;
+    ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+    ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext_IASetInputLayout(s_ctx, NULL);
+    ID3D11DeviceContext_VSSetShader(s_ctx, s_vs, NULL, 0);
+    ID3D11DeviceContext_PSSetShader(s_ctx, gamma ? s_ps_gamma : s_ps, NULL, 0);
+    {
+        ID3D11ShaderResourceView *v[2] = {srv, s_lut_srv};
+        ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, gamma ? 2 : 1, v);
+    }
+    ID3D11DeviceContext_PSSetSamplers(s_ctx, 0, 1, &s_samp);
+    ID3D11DeviceContext_Draw(s_ctx, 3, 0);
+    if (s_ovl_px && s_ovl_w && s_ovl_h) {
+        /* The overlay box, at its place in the frame, scaled as the frame is. */
+        if (s_ovl_w > s_ovl_cap_w || s_ovl_h > s_ovl_cap_h) {
+            D3D11_TEXTURE2D_DESC td;
+            if (s_ovl_srv) { ID3D11ShaderResourceView_Release(s_ovl_srv); s_ovl_srv = NULL; }
+            if (s_ovl_tex) { ID3D11Texture2D_Release(s_ovl_tex); s_ovl_tex = NULL; }
+            ZeroMemory(&td, sizeof td);
+            td.Width = s_ovl_w; td.Height = s_ovl_h; td.MipLevels = 1; td.ArraySize = 1;
+            td.Format = DXGI_FORMAT_B8G8R8A8_UNORM; td.SampleDesc.Count = 1;
+            td.Usage = D3D11_USAGE_DEFAULT; td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+            s_ovl_cap_w = s_ovl_cap_h = 0;
+            if (SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &s_ovl_tex))
+                && SUCCEEDED(ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)s_ovl_tex,
+                                                                   NULL, &s_ovl_srv))) {
+                s_ovl_cap_w = s_ovl_w; s_ovl_cap_h = s_ovl_h;
+            }
+        }
+        if (s_ovl_srv) {
+            D3D11_BOX box = {0, 0, 0, s_ovl_w, s_ovl_h, 1};
+            D3D11_VIEWPORT ov = vp;
+            ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)s_ovl_tex, 0, &box,
+                                                  s_ovl_px, s_ovl_w * 4, 0);
+            ov.TopLeftX = vp.TopLeftX + (float)s_ovl_x * sc;
+            ov.TopLeftY = vp.TopLeftY + (float)s_ovl_y * sc;
+            ov.Width = (float)s_ovl_cap_w * sc;
+            ov.Height = (float)s_ovl_cap_h * sc;
+            ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &ov);
+            ID3D11DeviceContext_PSSetShader(s_ctx, s_ps, NULL, 0);
+            ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &s_ovl_srv);
+            ID3D11DeviceContext_Draw(s_ctx, 3, 0);
+        }
+    }
+    if (s_capture_pending && InterlockedExchange(&s_capture_pending, 0))
+        capture_back_buffer();
+    t2 = gpu_present_now_ns();
+    s_step_ms[1] = (double)(t2 - t1) / 1e6;
+    if (s_present_at_ns)
+        wait_until_ns(s_present_at_ns);
+    t3 = gpu_present_now_ns();
+    s_step_ms[2] = (double)(t3 - t2) / 1e6;
+    {
+        int ok = IDXGISwapChain_Present(s_chain, (UINT)s_vsync,
+                                        !s_vsync && s_tearing ? DXGI_PRESENT_ALLOW_TEARING : 0) == S_OK;
+        s_step_ms[3] = (double)(gpu_present_now_ns() - t3) / 1e6;
+        return ok;
+    }
+}
+
+/* ---- Frames shared with the Vulkan renderer (no CPU copies) ----
+ *
+ * The renderer used to read each full-resolution frame back to the CPU, the
+ * window thread copied it, and this file uploaded it again: 33 MB three
+ * times a frame at 4K, 9-14 ms of upload alone, so presents came late and a
+ * VRR display held frames 25-45 ms. Now four textures made here are shared
+ * with the renderer (NT handles, a keyed mutex each): it copies each
+ * finished frame into the next one on the GPU and the presenter draws from
+ * it. The keyed mutex is the hand-over: the renderer takes key 0 and gives
+ * back key 1, the presenter takes key 1 and gives back key 0; a published
+ * frame the presenter skips is retired (taken and given back) so the
+ * renderer can have it again. */
+#define SH_N 4
+static ID3D11Texture2D          *s_sh_tex[SH_N];
+static ID3D11ShaderResourceView *s_sh_srv[SH_N];
+static IDXGIKeyedMutex          *s_sh_km[SH_N];
+static HANDLE                    s_sh_handle[SH_N];
+static uint32_t                  s_sh_w, s_sh_h;
+static SRWLOCK                   s_sh_lock = SRWLOCK_INIT;
+
+static void shared_free(void)
+{
+    int i;
+    for (i = 0; i < SH_N; i++) {
+        if (s_sh_km[i])     { IDXGIKeyedMutex_Release(s_sh_km[i]);          s_sh_km[i] = NULL; }
+        if (s_sh_srv[i])    { ID3D11ShaderResourceView_Release(s_sh_srv[i]); s_sh_srv[i] = NULL; }
+        if (s_sh_tex[i])    { ID3D11Texture2D_Release(s_sh_tex[i]);          s_sh_tex[i] = NULL; }
+        if (s_sh_handle[i]) { CloseHandle(s_sh_handle[i]);                   s_sh_handle[i] = NULL; }
+    }
+    s_sh_w = s_sh_h = 0;
+}
+
+int gpu_present_shared_make(uint32_t w, uint32_t h, void *handles[4], uint8_t luid[8])
+{
+    D3D11_TEXTURE2D_DESC td;
+    IDXGIDevice *dd = NULL;
+    IDXGIAdapter *ad = NULL;
+    DXGI_ADAPTER_DESC desc;
+    int i, ok = 1;
+    if (!s_dev || !s_flip || !w || !h)
+        return 0;
+    if (FAILED(ID3D11Device_QueryInterface(s_dev, &IID_IDXGIDevice, (void **)&dd))
+        || FAILED(IDXGIDevice_GetAdapter(dd, &ad)) || FAILED(IDXGIAdapter_GetDesc(ad, &desc))) {
+        if (ad) IDXGIAdapter_Release(ad);
+        if (dd) IDXGIDevice_Release(dd);
+        return 0;
+    }
+    memcpy(luid, &desc.AdapterLuid, 8);
+    IDXGIAdapter_Release(ad);
+    IDXGIDevice_Release(dd);
+    AcquireSRWLockExclusive(&s_sh_lock);
+    shared_free();
+    ZeroMemory(&td, sizeof td);
+    td.Width = w; td.Height = h; td.MipLevels = 1; td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM; td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_DEFAULT; td.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+    td.MiscFlags = D3D11_RESOURCE_MISC_SHARED_NTHANDLE | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX;
+    for (i = 0; i < SH_N && ok; i++) {
+        IDXGIResource1 *r1 = NULL;
+        ok = SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &s_sh_tex[i]))
+          && SUCCEEDED(ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)s_sh_tex[i],
+                                                             NULL, &s_sh_srv[i]))
+          && SUCCEEDED(ID3D11Texture2D_QueryInterface(s_sh_tex[i], &IID_IDXGIKeyedMutex,
+                                                      (void **)&s_sh_km[i]))
+          && SUCCEEDED(ID3D11Texture2D_QueryInterface(s_sh_tex[i], &IID_IDXGIResource1,
+                                                      (void **)&r1))
+          && SUCCEEDED(IDXGIResource1_CreateSharedHandle(r1, NULL,
+                                                         DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE,
+                                                         NULL, &s_sh_handle[i]));
+        if (r1)
+            IDXGIResource1_Release(r1);
+        handles[i] = ok ? s_sh_handle[i] : NULL;
+    }
+    if (ok) {
+        s_sh_w = w; s_sh_h = h;
+    } else {
+        shared_free();
+        fprintf(stderr, "  [D3D] shared frame textures failed; frames are copied through the CPU\n");
+    }
+    ReleaseSRWLockExclusive(&s_sh_lock);
+    return ok ? SH_N : 0;
+}
+
+/* Present shared frame i (w x h), the title's gamma ramp applied when gamma,
+ * at at_ns (0 = at once). 0: not shown (the hand-over timed out, occluded). */
+int gpu_present_shared_at(int i, uint32_t w, uint32_t h, int gamma, uint64_t at_ns)
+{
+    int ok = 0;
+    if (i < 0 || i >= SH_N)
+        return 0;
+    if (gamma && s_ps_gamma) {
+        extern unsigned xbox_FramebufferGammaSerial(void);
+        extern unsigned xbox_FramebufferGammaTexels(uint32_t *out256);
+        if (xbox_FramebufferGammaSerial() != s_lut_serial) {
+            uint32_t t[256];
+            s_lut_serial = xbox_FramebufferGammaTexels(t);
+            ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)s_lut, 0, NULL, t, 1024, 0);
+        }
+    }
+    AcquireSRWLockShared(&s_sh_lock);
+    {
+        uint64_t k0 = gpu_present_now_ns();
+        int got = s_sh_km[i] && w == s_sh_w && h == s_sh_h
+                  && IDXGIKeyedMutex_AcquireSync(s_sh_km[i], 1, 100) == S_OK;
+        s_step_ms[4] = (double)(gpu_present_now_ns() - k0) / 1e6;
+        if (!got) {
+            ReleaseSRWLockShared(&s_sh_lock);
+            return 0;
+        }
+    }
+    {
+        s_present_at_ns = at_ns;
+        ok = present_srv(s_sh_srv[i], w, h, NULL, gamma && s_ps_gamma);
+        s_present_at_ns = 0;
+        IDXGIKeyedMutex_ReleaseSync(s_sh_km[i], 0);
+    }
+    ReleaseSRWLockShared(&s_sh_lock);
+    return ok;
+}
+
+/* A published frame the presenter will not show: hand it back. */
+void gpu_present_shared_retire(int i)
+{
+    if (i < 0 || i >= SH_N)
+        return;
+    AcquireSRWLockShared(&s_sh_lock);
+    if (s_sh_km[i] && IDXGIKeyedMutex_AcquireSync(s_sh_km[i], 1, 100) == S_OK)
+        IDXGIKeyedMutex_ReleaseSync(s_sh_km[i], 0);
+    ReleaseSRWLockShared(&s_sh_lock);
+}
+
+/* The overlay box drawn over the next frames (frame pixels; NULL = none).
+ * The pixels must stay valid until the next call. */
+void gpu_present_overlay(const uint32_t *px, uint32_t w, uint32_t h, uint32_t x, uint32_t y)
+{
+    s_ovl_px = px; s_ovl_w = w; s_ovl_h = h; s_ovl_x = x; s_ovl_y = y;
+}
+
+static int present_draw(const uint32_t *pixels, int gamma)
+{
+    if (!pixels)
+        return 0;
+    return present_srv(s_srv, s_w, s_h, pixels, gamma);
+}
+
+void gpu_present_shutdown(void)
+{
+    if (s_ps)    { ID3D11PixelShader_Release(s_ps);           s_ps = NULL; }
+    if (s_ps_gamma) { ID3D11PixelShader_Release(s_ps_gamma);  s_ps_gamma = NULL; }
+    if (s_lut_srv) { ID3D11ShaderResourceView_Release(s_lut_srv); s_lut_srv = NULL; }
+    if (s_lut)   { ID3D11Texture2D_Release(s_lut);            s_lut = NULL; }
+    if (s_vs)    { ID3D11VertexShader_Release(s_vs);          s_vs = NULL; }
+    if (s_samp)  { ID3D11SamplerState_Release(s_samp);        s_samp = NULL; }
+    if (s_srv)   { ID3D11ShaderResourceView_Release(s_srv);   s_srv = NULL; }
+    if (s_frame) { ID3D11Texture2D_Release(s_frame);          s_frame = NULL; }
+    if (s_rtv)   { ID3D11RenderTargetView_Release(s_rtv);     s_rtv = NULL; }
+    shared_free();
+    if (s_ovl_srv) { ID3D11ShaderResourceView_Release(s_ovl_srv); s_ovl_srv = NULL; }
+    if (s_ovl_tex) { ID3D11Texture2D_Release(s_ovl_tex); s_ovl_tex = NULL; }
+    if (s_latency) { CloseHandle(s_latency);                  s_latency = NULL; }
+    if (s_chain) { IDXGISwapChain_Release(s_chain);           s_chain = NULL; }
+    if (s_ctx)   { ID3D11DeviceContext_Release(s_ctx);        s_ctx = NULL; }
+    if (s_dev)   { ID3D11Device_Release(s_dev);               s_dev = NULL; }
+}
+
+int gpu_present_active(void)
+{
+    return s_rtv != NULL;
+}
+#endif
diff --git a/src/video/gpu_present.h b/src/video/gpu_present.h
new file mode 100644
index 0000000..eed8e50
--- /dev/null
+++ b/src/video/gpu_present.h
@@ -0,0 +1,33 @@
+/* D3D11 presentation for the framebuffer window (see gpu_present.c). */
+#ifndef XBOX_GPU_PRESENT_H
+#define XBOX_GPU_PRESENT_H
+#if defined(_WIN32)
+#include <windows.h>
+#include <stdint.h>
+
+int  gpu_present_enabled(void);                 /* RECOMP_D3D_PRESENT=1 */
+int  gpu_present_init(HWND hwnd, uint32_t width, uint32_t height);
+int  gpu_present_frame_gamma(const uint32_t *pixels, uint32_t width, uint32_t height, int gamma); /* gamma: apply the title's ramp on the GPU */
+int  gpu_present_frame(const uint32_t *pixels); /* width*height B8G8R8A8; 0 = not shown (occluded) */
+int  gpu_present_frame_size(const uint32_t *pixels, uint32_t width, uint32_t height);
+int  gpu_present_active(void);
+void gpu_present_capture(const char *path);   /* next presented image -> BMP */
+void gpu_present_shutdown(void);
+/* Present at a host time (gpu_present_now_ns's clock, QPC in ns; 0 = at once). */
