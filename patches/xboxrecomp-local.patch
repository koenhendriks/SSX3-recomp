+             |  d3d8_expand_channel( rgb        & 0x1Fu, 5);
+    }
+    c[2] = c[3] = 0;
+    if (c0 > c1 || block_bytes == 16) {
+        for (i = 0; i < 3; i++) {
+            uint32_t sh = i * 8, m0 = (c[0] >> sh) & 0xFFu, m1 = (c[1] >> sh) & 0xFFu;
+            c[2] |= ((2 * m0 + m1) / 3) << sh;
+            c[3] |= ((m0 + 2 * m1) / 3) << sh;
+        }
+    } else {
+        for (i = 0; i < 3; i++) {
+            uint32_t sh = i * 8, m0 = (c[0] >> sh) & 0xFFu, m1 = (c[1] >> sh) & 0xFFu;
+            c[2] |= ((m0 + m1) / 2) << sh;
+        }
+    }
+
+    idx = (uint32_t)b[4] | ((uint32_t)b[5] << 8) | ((uint32_t)b[6] << 16) | ((uint32_t)b[7] << 24);
+    for (i = 0; i < 16; i++) {
+        uint32_t k = (idx >> (2 * i)) & 3u, a = alpha[i];
+        if (block_bytes == 8 && c0 <= c1 && k == 3)
+            a = 0;                         /* DXT1's one bit of alpha */
+        out[i] = (a << 24) | (c[k] & 0x00FFFFFFu);
+    }
+    return 1;
+}
