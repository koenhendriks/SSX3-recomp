+/* RECOMP_SNAP_TRIGGER=<file>: when the file appears, write the frame being
+ * shown to the BMP path it contains and delete it. Screenshots taken from
+ * inside work whatever presents the frame -- PrintWindow cannot read a D3D11
+ * swap chain -- and with the window covered (tools\live.ps1 snap uses it). */
+/* RECOMP_SNAP_SEQ=N with the snapshot trigger: the next N frames the window
+ * presents, one after another (copied to memory as they come, written as
+ * <path>_NN.bmp once all are in) -- frame-to-frame changes such as a HUD
+ * element jumping, which single screenshots seconds apart cannot show. */
+static int       s_seq_want, s_seq_have;
+static uint32_t *s_seq_px[64];
+static uint32_t  s_seq_w[64], s_seq_h[64];
+static char      s_seq_base[MAX_PATH];
+
+static void seq_write_bmp(const char *path, const uint32_t *px, uint32_t w, uint32_t h)
+{
+    FILE *f = fopen(path, "wb");
+    uint32_t row = (w * 3u + 3u) & ~3u, img = row * h, total = 54u + img, y, x;
+    uint8_t hdr[54] = {'B', 'M'}, *line;
+    if (!f)
+        return;
+    memcpy(hdr + 2, &total, 4); hdr[10] = 54; hdr[14] = 40;
+    memcpy(hdr + 18, &w, 4); memcpy(hdr + 22, &h, 4); hdr[26] = 1; hdr[28] = 24;
+    memcpy(hdr + 34, &img, 4);
+    fwrite(hdr, 1, 54, f);
+    line = (uint8_t *)calloc(1, row);
+    for (y = h; line && y-- > 0;) {
+        const uint32_t *src = px + (size_t)y * w;
+        for (x = 0; x < w; x++) {
+            line[x * 3] = (uint8_t)src[x]; line[x * 3 + 1] = (uint8_t)(src[x] >> 8);
+            line[x * 3 + 2] = (uint8_t)(src[x] >> 16);
+        }
+        fwrite(line, 1, row, f);
+    }
+    free(line);
+    fclose(f);
+}
+
+static void seq_frame(const uint32_t *px, uint32_t w, uint32_t h)
+{
+    int i;
+    if (s_seq_have >= s_seq_want)
+        return;
+    i = s_seq_have;
+    s_seq_px[i] = (uint32_t *)malloc((size_t)w * h * 4);
+    if (s_seq_px[i]) {
+        memcpy(s_seq_px[i], px, (size_t)w * h * 4);
+        s_seq_w[i] = w; s_seq_h[i] = h;
+    }
+    if (++s_seq_have == s_seq_want) {
+        char p[MAX_PATH + 16];
+        for (i = 0; i < s_seq_want; i++) {
+            if (s_seq_px[i]) {
+                snprintf(p, sizeof p, "%s_%02d.bmp", s_seq_base, i);
+                seq_write_bmp(p, s_seq_px[i], s_seq_w[i], s_seq_h[i]);
+                free(s_seq_px[i]);
+                s_seq_px[i] = NULL;
+            }
+        }
+        fprintf(stderr, "[FBWIN] %d consecutive frames written to %s_NN.bmp\n", s_seq_want, s_seq_base);
+        s_seq_want = s_seq_have = 0;
+    }
+}
