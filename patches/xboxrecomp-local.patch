diff --git a/tests/vblank_grid/test_main.c b/tests/vblank_grid/test_main.c
new file mode 100644
index 0000000..8f91b53
--- /dev/null
+++ b/tests/vblank_grid/test_main.c
@@ -0,0 +1,224 @@
+/*
+ * vblank_grid test: the emulated vblank's grid, free at 60 Hz or locked to
+ * a fixed display's refreshes (src/kernel/vblank_grid.c). A simulated clock
+ * steps in 0.05 ms; a simulated display reports its refreshes.
+ */
+#include "vblank_grid.h"
+#include <math.h>
+#include <stdio.h>
+
+#define NOMINAL (1000.0 / 60.0)
+#define MAXE 4096
+
+static int s_fail;
+
+static void check(int ok, const char *what)
+{
+    printf("  %s  %s\n", ok ? "ok  " : "FAIL", what);
+    if (!ok)
+        s_fail = 1;
+}
+
+typedef struct {
+    double edges[MAXE];
+    int    n;
+    double next_report;      /* the display's next refresh; 0 = no display */
+} sim;
+
+/* Run the clock from *t to t_end; the display (period disp_ms, 0 none)
+ * reports each refresh until report_until. Edges are recorded. */
+static void run(vg_grid *g, sim *s, double *t, double t_end, double disp_ms, double report_until)
+{
+    for (; *t < t_end; *t += 0.05) {
+        if (disp_ms > 0 && *t < report_until) {
+            if (!s->next_report)
+                s->next_report = *t;
+            if (*t >= s->next_report) {
+                vg_display_report(g, s->next_report, disp_ms);
+                s->next_report += disp_ms;
+            }
+        }
+        if (vg_due(g, *t) && s->n < MAXE)
+            s->edges[s->n++] = vg_last_edge(g);
+    }
+}
+
+static double max_dev(const sim *s, int from, double period)
+{
+    double m = 0;
+    int i;
+    if (from < 0 || s->n - from < 20)
+        return 1e9;                 /* too few edges to judge */
+    for (i = from + 1; i < s->n; i++) {
+        double d = fabs(s->edges[i] - s->edges[i - 1] - period);
+        if (d > m) m = d;
+    }
+    return m;
+}
+
+static void free_runs_at_60(void)
+{
+    vg_grid g; sim s = {0}; double t = 1000.0;
+    vg_init(&g, 60.0);
+    run(&g, &s, &t, 1000.0 + 10000.0, 0, 0);
+    check(s.n >= 599 && max_dev(&s, 0, NOMINAL) < 1e-6, "no display: edges 16.6667 ms apart");
+    check(!vg_locked(&g, t), "no display: not locked");
+}
+
+/* Do the edges sit on the display's refreshes (anchor + k * disp)? */
+static int on_refreshes(const sim *s, int from, double anchor, double disp)
+{
+    int i;
+    if (from < 0 || s->n - from < 20)
+        return 0;
+    for (i = from; i < s->n; i++) {
+        double k = (s->edges[i] - anchor) / disp;
+        if (fabs(k - floor(k + 0.5)) * disp > 0.01)
+            return 0;
+    }
+    return 1;
+}
+
+static void locks_to_59_94(void)
+{
+    vg_grid g; sim s = {0}; double t = 1000.0, disp = 1000.0 * 1001.0 / 60000.0;
+    vg_init(&g, 60.0);
+    run(&g, &s, &t, 1000.0 + 3000.0, disp, 1e12);
+    check(vg_locked(&g, t), "59.94 Hz display: locked");
+    check(fabs(vg_period(&g) - disp) < 0.001, "59.94 Hz display: period 16.6834 ms");
+    check(on_refreshes(&s, s.n - 60, 1000.0, disp), "59.94 Hz display: edges on its refreshes");
+    check(max_dev(&s, s.n - 60, disp) < 0.01, "59.94 Hz display: one refresh per edge");
+}
+
+static void locks_to_120_every_second(void)
+{
+    vg_grid g; sim s = {0}; double t = 1000.0, disp = 1000.0 / 120.0;
+    vg_init(&g, 60.0);
+    run(&g, &s, &t, 1000.0 + 3000.0, disp, 1e12);
+    check(vg_locked(&g, t), "120 Hz display: locked");
+    check(fabs(vg_period(&g) - NOMINAL) < 0.001, "120 Hz display: period 16.6667 ms");
+    check(on_refreshes(&s, s.n - 60, 1000.0, disp) && max_dev(&s, s.n - 60, NOMINAL) < 0.01,
+          "120 Hz display: edges on every second refresh");
+}
+
+static void no_lock_at_144(void)
+{
+    vg_grid g; sim s = {0}; double t = 1000.0, disp = 1000.0 / 144.0;
+    vg_init(&g, 60.0);
+    run(&g, &s, &t, 1000.0 + 3000.0, disp, 1e12);
+    check(!vg_locked(&g, t), "144 Hz display: not locked");
+    check(fabs(vg_period(&g) - NOMINAL) < 1e-6 && max_dev(&s, s.n - 60, NOMINAL) < 1e-6,
+          "144 Hz display: free 60 Hz grid");
+}
+
+/* A 30 Hz output (the dev PC's virtual display): half a guest vblank per
+ * refresh is not a multiple, so no lock. */
+static void no_lock_at_30(void)
+{
+    vg_grid g; sim s = {0}; double t = 1000.0, disp = 1000.0 / 30.0;
+    vg_init(&g, 60.0);
+    run(&g, &s, &t, 1000.0 + 3000.0, disp, 1e12);
+    check(!vg_locked(&g, t), "30 Hz display: not locked");
+    check(max_dev(&s, s.n - 60, NOMINAL) < 1e-6, "30 Hz display: free 60 Hz grid");
+}
+
+static void stale_reports_free_run(void)
+{
+    vg_grid g; sim s = {0}; double t = 1000.0, disp = 1000.0 * 1001.0 / 60000.0;
+    int before;
+    vg_init(&g, 60.0);
+    run(&g, &s, &t, 3000.0, disp, 3000.0);           /* locked, then the reports stop */
+    before = s.n;
+    run(&g, &s, &t, 3300.0, disp, 0);
+    check(!vg_locked(&g, t), "reports stop for 300 ms: unlocked");
+    run(&g, &s, &t, 5000.0, disp, 0);
+    check(max_dev(&s, before + 20, NOMINAL) < 1e-6, "after the reports stop: free 16.6667 ms edges");
+    check(max_dev(&s, before - 1, NOMINAL) < 0.02, "no jump at the hand-over");
+}
+
+static void stall_restarts(void)
+{
+    vg_grid g; double t = 1000.0, next;
+    vg_init(&g, 60.0);
+    vg_due(&g, t);
+    next = vg_next_edge(&g);
+    t = next + 80.0;                                  /* a stall: 80 ms late */
+    check(vg_due(&g, t) == 1, "late call fires once");
+    check(vg_due(&g, t) == 0, "and not again at once (no burst of missed edges)");
+    check(fabs(vg_next_edge(&g) - (t + NOMINAL)) < 1e-6, "the grid restarts from the late call");
+}
+
+static void nearest_edge(void)
+{
+    vg_grid g; double t = 1000.0, e;
+    vg_init(&g, 60.0);
+    vg_due(&g, t);
+    e = vg_last_edge(&g);
+    check(fabs(vg_nearest_edge(&g, e + 3.0) - e) < 1e-6, "3 ms after an edge: that edge");
+    check(fabs(vg_nearest_edge(&g, e + 10.0) - (e + NOMINAL)) < 1e-6, "10 ms after: the next");
+    check(fabs(vg_nearest_edge(&g, e + 40.0) - (e + 2 * NOMINAL)) < 1e-6, "40 ms after: two on");
+}
+
+/* The game's frame timer, re-armed after its tick's work: the next fire is
+ * the edge after the one this tick fired on, however long the work took. */
+static void snap_next_edge(void)
+{
+    vg_grid g; double t = 1000.0, e, due;
+    vg_init(&g, 60.0);
+    vg_due(&g, t);
+    vg_due(&g, vg_next_edge(&g));
+    e = vg_last_edge(&g);
+    due = vg_snap_due(&g, e + 0.3, e + 4.0);
+    check(fabs(due - (e + NOMINAL)) < 1e-6, "re-armed 4 ms into the tick: the next edge");
+    due = vg_snap_due(&g, e + 0.3, e + 12.0);
+    check(fabs(due - (e + NOMINAL)) < 1e-6, "re-armed 12 ms in (past half a period): still the next edge");
+    due = vg_snap_due(&g, e + 9.0, e + 13.0);
+    check(fabs(due - (e + NOMINAL)) < 1e-6, "a tick woken 9 ms late: still the edge after its own (no tick lost)");
+    due = vg_snap_due(&g, e + 16.0, e + 17.0);
+    check(fabs(due - (e + NOMINAL)) < 1e-6, "a tick woken 16 ms late: still the edge after its own");
+    due = vg_snap_due(&g, e + 0.3, e + 30.0);
+    check(fabs(due - (e + NOMINAL)) < 1e-6, "re-armed 30 ms in: the missed edge, so it fires at once (caught up)");
+    due = vg_snap_due(&g, e + 0.3, e + 60.0);
+    check(fabs(due - (e + 4 * NOMINAL)) < 1e-6, "re-armed after a 60 ms stall: the first edge after now (the game catches up)");
+}
+
+/* The tick's own edge, for tagging the frame it renders. */
+static void own_edge(void)
+{
+    vg_grid g; double t = 1000.0, e;
+    vg_init(&g, 60.0);
+    vg_due(&g, t);
+    vg_due(&g, vg_next_edge(&g));
+    e = vg_last_edge(&g);
+    check(fabs(vg_own_edge(&g, e + 0.2) - e) < 1e-6, "woken at its edge: that edge");
+    check(fabs(vg_own_edge(&g, e + 16.0) - e) < 1e-6, "woken 16 ms late: still its own edge, not the next");
+    check(fabs(vg_own_edge(&g, e + 17.0) - (e + NOMINAL)) < 1e-6, "17 ms on: the next edge (it is that tick's)");
+}
+
+static void snap_locked_59_94(void)
+{
+    vg_grid g; sim s = {0}; double t = 1000.0, disp = 1000.0 * 1001.0 / 60000.0, e;
+    vg_init(&g, 60.0);
+    run(&g, &s, &t, 3000.0, disp, 1e12);
+    e = vg_last_edge(&g);
+    check(fabs(vg_snap_due(&g, e + 0.2, e + 5.0) - (e + disp)) < 1e-6,
+          "locked to 59.94 Hz: the next edge is one display refresh on");
+}
+
+int main(void)
+{
+    printf("vblank_grid\n");
+    free_runs_at_60();
+    locks_to_59_94();
+    locks_to_120_every_second();
+    no_lock_at_144();
+    no_lock_at_30();
+    stale_reports_free_run();
+    stall_restarts();
+    nearest_edge();
+    snap_next_edge();
+    snap_locked_59_94();
+    own_edge();
+    printf(s_fail ? "FAILED\n" : "all passed\n");
+    return s_fail;
+}
