+static void tex_decode_dxt_job(int k, int n)
+{
+    const Texture *t = s_dec_tex;
+    uint32_t bb = d3d8_format_dxt_block_bytes(t->color);
+    uint32_t bw = (t->width + 3) >> 2, bh = (t->height + 3) >> 2;
+    uint32_t faces = t->cube ? 6 : 1, stride = t->cube ? tex_face_stride(t) : 0;
+    uint32_t r, bx, i, px[16];
+    for (r = (uint32_t)k; r < bh * faces; r += (uint32_t)n) {
+        uint32_t face = r / bh, by = r % bh;
+        const uint8_t *row = XBOX_HOST(t->offset + face * stride) + (size_t)by * bw * bb;
+        for (bx = 0; bx < bw; bx++) {
+            if (!d3d8_dxt_decode_block(row + (size_t)bx * bb, t->color, px))
+                for (i = 0; i < 16; i++)
+                    px[i] = 0xFFFF00FFu;
+            for (i = 0; i < 16; i++) {
+                uint32_t x = bx * 4 + (i & 3), y = by * 4 + (i >> 2);
+                if (x < t->width && y < t->height)
+                    s_dec_out[((size_t)face * t->height + y) * t->width + x] = px[i];
+            }
+        }
+    }
+}
+
+/* Rows k, k+n, ... of the texture being decoded. */
+static void tex_decode_job(int k, int n)
+{
+    const Texture *t = s_dec_tex;
+    uint32_t x, y, rows = t->cube ? t->height * 6 : t->height;
+    uint32_t stride = t->cube ? tex_face_stride(t) : 0;
+    if (d3d8_format_dxt_block_bytes(t->color) && !getenv_fast_dxt_off()) {
+        tex_decode_dxt_job(k, n);
+        return;
+    }
+    for (y = (uint32_t)k; y < rows; y += (uint32_t)n)
+        for (x = 0; x < t->width; x++) {
+            uint32_t argb = 0xFFFF00FFu;
+            if (!sample_tex(t, (y / t->height) * stride, x, y % t->height, &argb))
+                argb = 0xFFFF00FFu;          /* unsupported format: magenta */
+            s_dec_out[y * t->width + x] = argb;
+        }
+}
+
+int nv2a_exec_tex_decode(int stage, uint32_t *out)
+{
+    const Texture *t;
+
+    if (stage < 0 || stage > 3)
+        return 0;
+    t = &s_gpu.texs[stage];
+    if (!t->valid)
+        return 0;
+    s_dec_tex = t;
+    s_dec_out = out;
+    if (t->width * t->height >= 4096)
+        pool_run(tex_decode_job);
+    else
+        tex_decode_job(0, 1);
+    return 1;
+}
