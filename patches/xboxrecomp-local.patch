diff --git a/tests/dxt_block/test_main.c b/tests/dxt_block/test_main.c
new file mode 100644
index 0000000..d12b91b
--- /dev/null
+++ b/tests/dxt_block/test_main.c
@@ -0,0 +1,54 @@
+/*
+ * dxt_block test: d3d8_dxt_decode_block (a whole 4x4 block in one pass, for
+ * decoding full textures) gives exactly what sixteen d3d8_dxt_decode_texel
+ * calls give, for DXT1, DXT3 and DXT5 blocks of every kind: random bytes,
+ * DXT1's three-colour mode (c0 <= c1), DXT5's six- and eight-step alpha.
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "d3d8_swizzle.h"
+
+static uint32_t s_rng = 12345;
+static uint8_t rnd(void) { s_rng = s_rng * 1103515245u + 12345u; return (uint8_t)(s_rng >> 16); }
+
+static int same_block(const uint8_t *blk, uint32_t fmt)
+{
+    uint32_t by_texel[16], by_block[16], i;
+    for (i = 0; i < 16; i++)
+        d3d8_dxt_decode_texel(blk, fmt, i & 3, i >> 2, 4, &by_texel[i]);
+    memset(by_block, 0xCD, sizeof by_block);
+    if (!d3d8_dxt_decode_block(blk, fmt, by_block))
+        return 0;
+    return !memcmp(by_texel, by_block, sizeof by_texel);
+}
+
+int main(void)
+{
+    static const uint32_t fmts[3] = {0x0C, 0x0E, 0x0F};   /* DXT1, DXT3, DXT5 */
+    static const char *names[3] = {"DXT1", "DXT3", "DXT5"};
+    int f, n, fail = 0;
+    printf("dxt_block\n");
+    for (f = 0; f < 3; f++) {
+        int bad = 0;
+        for (n = 0; n < 20000; n++) {
+            uint8_t blk[16];
+            uint32_t i;
+            for (i = 0; i < 16; i++)
+                blk[i] = rnd();
+            /* every other block forced into the less common modes */
+            if (n & 1) {
+                uint8_t *col = blk + (fmts[f] == 0x0C ? 0 : 8);
+                uint8_t t0 = col[0], t1 = col[1];
+                col[0] = col[2]; col[1] = col[3]; col[2] = t0; col[3] = t1;   /* swap c0/c1 */
+                if (fmts[f] == 0x0F) { uint8_t a = blk[0]; blk[0] = blk[1]; blk[1] = a; }
+            }
+            if (!same_block(blk, fmts[f]))
+                bad++;
+        }
+        printf("  %s  %s: 20000 blocks, %d differ\n", bad ? "FAIL" : "ok  ", names[f], bad);
+        fail |= bad != 0;
+    }
+    printf(fail ? "FAILED\n" : "all passed\n");
+    return fail;
+}
