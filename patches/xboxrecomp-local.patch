+void xbox_FramebufferSnapshot(const char *path)
+{
+    if (gpu_present_active()) {
+        gpu_present_capture(path);
+        return;
+    }
+    s_dump_quiet = 1;
+    xbox_FramebufferDumpBmp(path);
+    s_dump_quiet = 0;
+}
