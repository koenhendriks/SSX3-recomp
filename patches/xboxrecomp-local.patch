+/**
+ * POSIX counterpart of fb_present.c: show the guest framebuffer in an SDL2
+ * window. Same contract (RECOMP_FB_WINDOW, flip-time copy, BMP dump, snap
+ * trigger, keyboard state), minus the D3D11 presenter.
+ */
+#include <stdint.h>
+
+#if !defined(_WIN32)
+#define _GNU_SOURCE
+#include <SDL2/SDL.h>
+#include <pthread.h>
+#include <stdio.h>
