+static int pacing_present(LONG k)
+{
+    gpu_present_overlay(NULL, 0, 0, 0, 0);       /* drawn into the pixels instead */
+    return pacing_present_frame(s_hi[k], -1, s_hi_w[k], s_hi_h[k], s_hi_vbl[k], s_hi_arr[k]);
