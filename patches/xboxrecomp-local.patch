+ * Frames are shown in turn while each newer one's own time is still ahead
+ * (pc_pacer_skip): a timed lead over a refresh queues the next frame before
+ * this one is shown, and showing only the newest dropped every other frame.
+ * More than two waiting: behind, the older ones go (the renderer has four
+ * textures and must not wait for one). */
+static int shared_present_pending(void)
+{
+    LONG h = s_shq_head, t = InterlockedCompareExchange(&s_shq_tail, 0, 0);
+    ShFrame f;
+    if (h == t)
+        return 0;
+    if (t - h > SHQ)
+        h = t - SHQ;                          /* lost entries: none to hand back */
+    while (t - h > 1                          /* older ones: hand them back */
+           && (t - h > 2 || s_pstrat < 0
+               || pc_pacer_skip(&s_pacer, (uint64_t)(s_shq[(h + 1) % SHQ].vbl * 1e6),
+                                gpu_present_now_ns())))
+        gpu_present_shared_retire(s_shq[h++ % SHQ].tex);
+    f = s_shq[h % SHQ];
+    InterlockedExchange(&s_shq_head, h + 1);
