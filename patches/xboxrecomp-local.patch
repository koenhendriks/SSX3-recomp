diff --git a/tests/vbl_fifo/test_main.c b/tests/vbl_fifo/test_main.c
new file mode 100644
index 0000000..c62fb76
--- /dev/null
+++ b/tests/vbl_fifo/test_main.c
@@ -0,0 +1,59 @@
+/*
+ * vbl_fifo test: each frame's vblank, pushed once per present and popped
+ * once per flip (src/video/vbl_fifo.h). A present that makes no flip leaves
+ * an extra entry; the pop skips entries more than max_age old while a
+ * newer one waits, so the frames' vblanks come back in step by themselves.
+ */
+#include "vbl_fifo.h"
+#include <math.h>
+#include <stdio.h>
+
+#define P (1000.0 / 60.0)
+static int s_fail;
+static void check(int ok, const char *what)
+{
+    printf("  %s  %s\n", ok ? "ok  " : "FAIL", what);
+    if (!ok) s_fail = 1;
+}
+
+/* Frames k = 0..n: present at tick k (vblank 1000 + k*P), its flip 12 ms
+ * later; extra presents (no flip) at the ticks in `extra`. Returns the last
+ * popped vblank's age at its flip. */
+static double run(vbl_fifo *f, int n, int extra_at, int extras)
+{
+    double last_age = -1;
+    int k, e;
+    for (k = 0; k < n; k++) {
+        double vbl = 1000.0 + k * P, flip_t = vbl + 12.0, got;
+        vbl_fifo_push(f, vbl);
+        if (k == extra_at)
+            for (e = 0; e < extras; e++)
+                vbl_fifo_push(f, vbl);          /* presents without a flip */
+        got = vbl_fifo_pop(f, flip_t, 1.5 * P);
+        last_age = got > 0 ? flip_t - got : -1;
+    }
+    return last_age;
+}
+
+int main(void)
+{
+    vbl_fifo f;
+    double age;
+    printf("vbl_fifo\n");
+    vbl_fifo_init(&f);
+    age = run(&f, 300, -1, 0);
+    check(fabs(age - 12.0) < 1e-6, "in step: each flip gets its own frame's vblank");
+    vbl_fifo_init(&f);
+    age = run(&f, 300, 50, 2);
+    check(fabs(age - 12.0) < 1e-6, "two presents without a flip: back in step");
+    vbl_fifo_init(&f);
+    age = run(&f, 300, 50, 20);
+    check(fabs(age - 12.0) < 1e-6, "a full FIFO of extras: back in step");
+    vbl_fifo_init(&f);
+    check(vbl_fifo_pop(&f, 5000.0, 25.0) == 0.0, "empty: 0");
+    vbl_fifo_init(&f);
+    vbl_fifo_push(&f, 1000.0);
+    check(vbl_fifo_pop(&f, 1100.0, 25.0) == 1000.0, "an old entry with nothing newer is still taken");
+    printf(s_fail ? "FAILED\n" : "all passed\n");
+    return s_fail;
+}
