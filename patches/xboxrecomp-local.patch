diff --git a/src/kernel/vblank_grid.c b/src/kernel/vblank_grid.c
new file mode 100644
index 0000000..d5117e4
--- /dev/null
+++ b/src/kernel/vblank_grid.c
@@ -0,0 +1,114 @@
+/*
+ * vblank_grid.c - see vblank_grid.h.
+ *
+ * Locking follows the rule of kernel_pacing.c on the takedawn toolkit
+ * (xenophobentx/xboxrecomp), simplified: a display whose refresh period, or
+ * a whole multiple of it (1..4), is within 1% of the guest's 1000/60 ms
+ * moves the grid onto its refreshes -- each next edge is the refresh
+ * nearest one guest period after the last edge. Ten reports in a row on one
+ * period lock it; 250 ms without one and the grid runs free from its last
+ * edge. A stall of more than 50 ms restarts the grid from now instead of
+ * delivering the missed edges back to back.
+ */
+#include "vblank_grid.h"
+#include <math.h>
+
+#define VG_STALE_MS   250.0
+#define VG_STALL_MS   50.0
+#define VG_LOCK_AFTER 10
+#define VG_TOL        0.01      /* 1% of the guest period */
+#define VG_MULT_MAX   4
+
+void vg_init(vg_grid *g, double hz)
+{
+    vg_grid z = {0};
+    *g = z;
+    g->nominal_ms = 1000.0 / (hz > 0 ? hz : 60.0);
+}
+
+void vg_display_report(vg_grid *g, double when_ms, double period_ms)
+{
+    int k;
+    if (period_ms <= 0)
+        return;
+    if (g->disp_ms && fabs(period_ms - g->disp_ms) > g->disp_ms * 0.001)
+        g->reports = 0;                       /* a new period: learn it again */
+    g->disp_ms = period_ms;
+    g->anchor_ms = when_ms;
+    g->report_ms = when_ms;
+    g->reports++;
+    k = (int)floor(g->nominal_ms / period_ms + 0.5);
+    g->mult = (k >= 1 && k <= VG_MULT_MAX
+               && fabs(k * period_ms - g->nominal_ms) <= g->nominal_ms * VG_TOL) ? k : 0;
+}
+
+int vg_locked(const vg_grid *g, double now_ms)
+{
+    return g->mult > 0 && g->reports >= VG_LOCK_AFTER && now_ms - g->report_ms <= VG_STALE_MS;
+}
+
+double vg_period(const vg_grid *g)
+{
+    return g->locked ? g->mult * g->disp_ms : g->nominal_ms;
+}
+
+int vg_due(vg_grid *g, double now_ms)
+{
+    if (g->next_ms && now_ms < g->next_ms)
+        return 0;
+    g->locked = vg_locked(g, now_ms);
+    if (!g->next_ms || now_ms - g->next_ms > VG_STALL_MS)
+        g->last_ms = now_ms;                  /* start, or restart after a stall */
+    else
+        g->last_ms = g->next_ms;
+    if (g->locked) {
+        double target = g->last_ms + g->mult * g->disp_ms;
+        double n = floor((target - g->anchor_ms) / g->disp_ms + 0.5);
+        g->next_ms = g->anchor_ms + n * g->disp_ms;
+        while (g->next_ms <= now_ms)
+            g->next_ms += g->disp_ms;
+    } else {
+        g->next_ms = g->last_ms + g->nominal_ms;
+    }
+    return 1;
+}
+
+double vg_next_edge(const vg_grid *g)
+{
+    return g->next_ms;
+}
+
+double vg_last_edge(const vg_grid *g)
+{
+    return g->last_ms;
+}
+
+double vg_nearest_edge(const vg_grid *g, double t_ms)
+{
+    double p = vg_period(g);
+    return g->last_ms + floor((t_ms - g->last_ms) / p + 0.5) * p;
+}
+
+double vg_snap_due(const vg_grid *g, double fire_ms, double now_ms)
+{
+    /* The tick's own edge is the last one at or before its wake-up (a timer
+     * fires at or after its due time -- kernel_timer_thread re-checks before
+     * firing; 0.05 ms covers rounding). The nearest edge was the next one for a tick woken more than
+     * half a period late, and the re-arm then skipped a whole tick. */
+    double p = vg_period(g);
+    double due = vg_own_edge(g, fire_ms) + p;
+    /* Just missed (re-armed after its next edge): keep it, so the timer
+     * fires at once and the tick is caught up. A long stall (more than two
+     * periods behind) goes to the next edge: the game's own carry catches
+     * up the rest, as it did before the grid. */
+    if (now_ms - due > 2.0 * p)
+        while (due <= now_ms)
+            due += p;
+    return due;
+}
+
+double vg_own_edge(const vg_grid *g, double fire_ms)
+{
+    double p = vg_period(g);
+    return g->last_ms + floor((fire_ms + 0.05 - g->last_ms) / p) * p;
+}
diff --git a/src/kernel/vblank_grid.h b/src/kernel/vblank_grid.h
new file mode 100644
index 0000000..c95cedd
--- /dev/null
+++ b/src/kernel/vblank_grid.h
@@ -0,0 +1,43 @@
+/*
+ * vblank_grid.h - the emulated vblank's grid (kernel_bridge.c's
+ * kernel_vblank_tick): free at 60 Hz, or locked to a fixed display's
+ * refreshes when the display runs at a whole multiple of 60 Hz (59.94,
+ * 60, 120, 240 ...), so each guest frame lands on the same refresh phase.
+ *
+ * Pure arithmetic on host milliseconds (qpc_now_ms), no clock or lock of
+ * its own: kernel_bridge.c holds the lock, tests/vblank_grid drives it.
+ */
+#ifndef XBOX_VBLANK_GRID_H
+#define XBOX_VBLANK_GRID_H
+
+typedef struct vg_grid {
+    double nominal_ms;      /* 1000 / RECOMP_VBLANK_HZ */
+    double next_ms;         /* the next edge; 0 = not started */
+    double last_ms;         /* the last edge fired */
+    double disp_ms;         /* the display's refresh period; 0 none */
+    double anchor_ms;       /* a display refresh (the last report) */
+    double report_ms;       /* host time of the last report */
+    int    reports;         /* reports in a row on one period */
+    int    mult;            /* refreshes per guest vblank; 0 = not a multiple */
+    int    locked;          /* at the last vg_due */
+} vg_grid;
+
+void   vg_init(vg_grid *g, double hz);
+/* One refresh of a fixed-rate display at when_ms, its period period_ms. */
+void   vg_display_report(vg_grid *g, double when_ms, double period_ms);
+/* 1 when an edge is due at now_ms (and the grid moves on), else 0. */
+int    vg_due(vg_grid *g, double now_ms);
+double vg_next_edge(const vg_grid *g);
+double vg_last_edge(const vg_grid *g);
+double vg_nearest_edge(const vg_grid *g, double t_ms);
+int    vg_locked(const vg_grid *g, double now_ms);
+double vg_period(const vg_grid *g);
+/* A timer re-armed at now_ms by a tick that woke at fire_ms: the edge
+ * after the tick's own (the last edge at or before fire_ms), even when that
+ * has just passed (the timer then fires at once: the tick is caught up);
+ * after a stall of more than two periods, the first edge after now_ms. */
+double vg_snap_due(const vg_grid *g, double fire_ms, double now_ms);
+/* The edge a tick that woke at fire_ms belongs to: the last at or before it. */
+double vg_own_edge(const vg_grid *g, double fire_ms);
+
+#endif
