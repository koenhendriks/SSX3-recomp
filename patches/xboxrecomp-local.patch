+/* Present one frame paced -- CPU pixels px, or shared texture tex (px
+ * NULL) -- w x h, whose vblank was vbl (ms) and which was published at
+ * arr_ns; 0 when nothing was shown. */
+static int pacing_present_frame(const uint32_t *px, int tex, uint32_t w, uint32_t h, double vbl,
+                                uint64_t arr_ns)
+{
+    pc_aim aim;
+    uint64_t now = gpu_present_now_ns(), g;
+    uint32_t pc;
+    int r;
+    memset(&aim, 0, sizeof aim);
+    pacing_probe(now);
+    if (s_pstrat > PC_LEGACY && vbl > 0.0) {
+        /* How late the frame came, from its publish: measured when the
+         * window thread got to it instead, a long lead (the thread waiting
+         * for an earlier frame's time) read as lateness and raised the lead
+         * further -- to its 33 ms cap after a single hitch. */
+        double lag = (double)(arr_ns && arr_ns <= now ? arr_ns : now) / 1e6 - vbl;
+        if (lag < s_lag_min) s_lag_min = lag;
+        if (lag > s_lag_max) s_lag_max = lag;
+        if (s_nlags < 128 && lag >= 0.0 && lag < 200.0)
+            s_lags[s_nlags++] = (float)lag;
+        pc_pacer_aim(&s_pacer, (uint64_t)(vbl * 1e6), now, &aim);
+        if (aim.at_ns && now >= aim.at_ns)
+            s_p_late++;
+        if (aim.at_ns > now + 100000000ull)   /* never park a frame */
+            aim.at_ns = 0;
+    }
+    r = px ? gpu_present_frame_at(px, w, h, 1, aim.at_ns)
+           : gpu_present_shared_at(tex, w, h, 1, aim.at_ns);
+    {
+        uint64_t t = gpu_present_now_ns();
+        if (s_p_prev && t > s_p_prev && (double)(t - s_p_prev) / 1e6 > 25.0
+            && s_pstrat > PC_LEGACY && getenv("RECOMP_FRAME_STATS")) {
+            /* A present over 25 ms after the last: where this one's time went,
+             * and how late its frame was picked up (at most 2 lines a second). */
+            static uint64_t said;
+            static int n;
+            double st[5];
+            if (t - said > 1000000000ull) { said = t; n = 0; }
+            if (n++ < 2) {
+                gpu_present_last_steps(st);
+                fprintf(stderr, "[PRESENT-SLOW] %.1f ms since the last present: hand-over %.1f, latency wait %.1f,"
+                        " upload+draw %.1f, wait for its time %.1f, Present %.1f ms;"
+                        " frame %.1f ms after its vblank, aimed at vblank+%.1f, lead %.1f\n",
+                        (double)(t - s_p_prev) / 1e6, px ? 0.0 : st[4], st[0], st[1], st[2], st[3],
+                        vbl > 0.0 ? (double)now / 1e6 - vbl : -1.0,
+                        aim.at_ns && vbl > 0.0 ? (double)aim.at_ns / 1e6 - vbl : -1.0,
+                        s_pacer.lead_ns / 1e6);
+            }
+        }
+        if (s_p_prev && t > s_p_prev) {
+            double iv = (double)(t - s_p_prev) / 1e6;
+            if (iv < 50.0) {
+                if (iv < s_p_min) s_p_min = iv;
+                if (iv > s_p_max) s_p_max = iv;
+            }
+        }
+        s_p_prev = t;
+    }
+    if (r && s_pstrat > PC_LEGACY) {
+        PcAimRec *a = &s_paims[s_paim_n++ % 8];
+        a->count = gpu_present_last_count();
+        a->aim = aim;
+    }
+    if (gpu_present_glass(&pc, &g) && pc != s_glass_count) {
+        uint32_t i;
+        for (i = 0; i < 8; i++)
+            if (s_paims[i].count == pc) {
+                pc_pacer_glass(&s_pacer, &s_paims[i].aim, g);
+                break;
+            }
+        if (s_glass_prev && pc == s_glass_count + 1 && g > s_glass_prev) {
+            double iv = (double)(g - s_glass_prev) / 1e6;
+            s_g_shown++;
+            if (iv > s_g_max) s_g_max = iv;
+            if (iv < s_g_min) s_g_min = iv;
+            if (iv > 1.5 * 1000.0 / 60.0)
+                s_g_long++;
+        }
+        s_glass_count = pc;
+        s_glass_prev = g;
+    }
+    return r;
+}
