+elseif(NOT WIN32)
+    target_sources(xbox_video PRIVATE fb_present_sdl.c)
+else()
+    target_sources(xbox_video PRIVATE dxgi_vblank.c)
+endif()
 target_include_directories(xbox_video PUBLIC
     ${CMAKE_CURRENT_SOURCE_DIR}
     ${CMAKE_CURRENT_SOURCE_DIR}/..
 )
 target_link_libraries(xbox_video PUBLIC xbox_d3d8)
 if(WIN32)
-    target_link_libraries(xbox_video PUBLIC mfplat mfreadwrite mfuuid mf ole32)
+    target_link_libraries(xbox_video PUBLIC mfplat mfreadwrite mfuuid mf ole32 d3d11 dxgi)
 endif()
diff --git a/src/video/dxgi_vblank.c b/src/video/dxgi_vblank.c
new file mode 100644
index 0000000..4262387
--- /dev/null
+++ b/src/video/dxgi_vblank.c
@@ -0,0 +1,335 @@
+/* Ported from xenophobentx/xboxrecomp (branch takedawn, MIT), 2026-10-26:
+ * the DXGI vblank thread of src/video/fb_present_vulkan.c, without its
+ * Vulkan, SDL and HDR parts.
+ *
+ * dxgi_vblank.c - Windows: follow the display the game window is on.
+ *
+ * A thread waits for each vertical blank of the window's output
+ * (IDXGIOutput::WaitForVBlank) and feeds the returns to the model in
+ * dxgi_vblank_model.h. On a fixed-rate display the model reports a refresh
+ * grid with the mode's exact period (QueryDisplayConfig: 60000/1001 for
+ * 59.94), which goes to the emulated vblank (xbox_VblankDisplayRefresh,
+ * kernel_bridge.c: it locks to it where the rate is a multiple of 60 Hz).
+ * Under variable refresh the returns are our own presents, so nothing is
+ * reported and the vblank keeps its own 60.000 Hz, which the display then
+ * follows. Once a second it looks at which monitor the window is on and at
+ * that monitor's mode, so a window moved to another display (or a mode
+ * change) is followed. The presenter reads the result with
+ * xbox_DxgiVblankDisplay (fb_present.c's frame pacing).
+ */
+#if defined(_WIN32)
+#define COBJMACROS
+#include <windows.h>
+#include <dxgi.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "dxgi_vblank_model.h"
+#include "dxgi_vblank.h"
+
+extern void xbox_VblankDisplayRefresh(double when_ms, double period_ms);
+
+typedef HRESULT (WINAPI *dxgi_create_fn)(REFIID, void **);
+static dxgi_create_fn s_create;
+static volatile LONG  s_run;
+static HWND           s_hwnd;
+static volatile LONGLONG s_period_ns;   /* the mode's period; 0 unknown */
+static volatile LONG  s_exact;
+static volatile LONG  s_state = DVM_UNKNOWN;
+static int            s_report = 1;   /* feed refreshes to the vblank grid */
+
+static uint64_t mono_ns(void)
+{
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart)
+        QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (uint64_t)((double)c.QuadPart * 1e9 / (double)f.QuadPart);
+}
+
+static IDXGIFactory1 *new_factory(void)
+{
+    static const GUID iid_factory1 = { 0x770aae78, 0xf26f, 0x4dba,
+        { 0xa8, 0x29, 0x25, 0x3c, 0x83, 0xd1, 0xb3, 0x87 } };
+    IDXGIFactory1 *fac = NULL;
+    if (!s_create || FAILED(s_create(&iid_factory1, (void **)&fac)))
+        return NULL;
+    return fac;
+}
+
+/* The DXGI output that shows monitor mon (a reference), or NULL. */
+static IDXGIOutput *output_for(HMONITOR mon)
+{
+    IDXGIFactory1 *fac = new_factory();
+    IDXGIOutput *found = NULL;
+    UINT a, o;
+    for (a = 0; fac && !found; a++) {
+        IDXGIAdapter1 *ad = NULL;
+        if (FAILED(IDXGIFactory1_EnumAdapters1(fac, a, &ad)) || !ad)
+            break;
+        for (o = 0; !found; o++) {
+            IDXGIOutput *out = NULL;
+            DXGI_OUTPUT_DESC od;
+            if (FAILED(IDXGIAdapter1_EnumOutputs(ad, o, &out)) || !out)
+                break;
+            if (SUCCEEDED(IDXGIOutput_GetDesc(out, &od)) && od.Monitor == mon)
+                found = out;
+            else
+                IDXGIOutput_Release(out);
+        }
+        IDXGIAdapter1_Release(ad);
+    }
+    if (fac)
+        IDXGIFactory1_Release(fac);
+    return found;
+}
+
+/* The refresh period of monitor mon's current mode: the exact rational from
+ * QueryDisplayConfig (*exact 1), else EnumDisplaySettings' whole hertz
+ * (*exact 0). 0 when neither says. */
+static uint64_t mode_period(HMONITOR mon, int *exact, unsigned *num, unsigned *den)
+{
+    MONITORINFOEXW mi;
+    DEVMODEW dm;
+    UINT32 np = 0, nm = 0, i;
+    DISPLAYCONFIG_PATH_INFO *paths = NULL;
+    DISPLAYCONFIG_MODE_INFO *modes = NULL;
+    uint64_t period = 0;
+    int tries;
+
+    *exact = 0;
+    *num = *den = 0;
+    memset(&mi, 0, sizeof mi);
+    mi.cbSize = sizeof mi;
+    if (!GetMonitorInfoW(mon, (MONITORINFO *)&mi))
+        return 0;
+    for (tries = 0; tries < 3; tries++) {
+        LONG rc;
+        free(paths);
+        free(modes);
+        paths = NULL;
+        modes = NULL;
+        if (GetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &np, &nm) != ERROR_SUCCESS)
+            break;
+        paths = (DISPLAYCONFIG_PATH_INFO *)calloc(np ? np : 1, sizeof *paths);
+        modes = (DISPLAYCONFIG_MODE_INFO *)calloc(nm ? nm : 1, sizeof *modes);
+        if (!paths || !modes)
+            break;
+        rc = QueryDisplayConfig(QDC_ONLY_ACTIVE_PATHS, &np, paths, &nm, modes, NULL);
+        if (rc == ERROR_INSUFFICIENT_BUFFER)
+            continue;
+        if (rc != ERROR_SUCCESS)
+            break;
+        for (i = 0; i < np && !period; i++) {
+            DISPLAYCONFIG_SOURCE_DEVICE_NAME sn;
+            DISPLAYCONFIG_RATIONAL r;
+            UINT32 mi_idx;
+            memset(&sn, 0, sizeof sn);
+            sn.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+            sn.header.size = sizeof sn;
+            sn.header.adapterId = paths[i].sourceInfo.adapterId;
+            sn.header.id = paths[i].sourceInfo.id;
+            if (DisplayConfigGetDeviceInfo(&sn.header) != ERROR_SUCCESS
+                    || wcscmp(sn.viewGdiDeviceName, mi.szDevice))
+                continue;
+            r = paths[i].targetInfo.refreshRate;
+            mi_idx = paths[i].targetInfo.modeInfoIdx;
+            if (mi_idx != DISPLAYCONFIG_PATH_MODE_IDX_INVALID && mi_idx < nm
+                    && modes[mi_idx].infoType == DISPLAYCONFIG_MODE_INFO_TYPE_TARGET
+                    && modes[mi_idx].targetMode.targetVideoSignalInfo.vSyncFreq.Numerator
+                    && modes[mi_idx].targetMode.targetVideoSignalInfo.vSyncFreq.Denominator)
+                r = modes[mi_idx].targetMode.targetVideoSignalInfo.vSyncFreq;
+            if (r.Numerator && r.Denominator) {
+                period = ((uint64_t)r.Denominator * 1000000000ull + r.Numerator / 2)
+                         / r.Numerator;
+                *num = r.Numerator;
+                *den = r.Denominator;
+                *exact = 1;
+            }
+        }
+        break;
+    }
+    free(paths);
+    free(modes);
+    if (period < 2000000u || period > 50000000u) {
+        period = 0;
+        *exact = 0;
+        memset(&dm, 0, sizeof dm);
+        dm.dmSize = sizeof dm;
+        if (EnumDisplaySettingsW(mi.szDevice, ENUM_CURRENT_SETTINGS, &dm)
+                && dm.dmDisplayFrequency > 1 && dm.dmDisplayFrequency < 500) {
+            period = 1000000000ull / dm.dmDisplayFrequency;
+            *num = dm.dmDisplayFrequency;
+            *den = 1;
+        }
+    }
+    return period;
+}
+
+static void say_state(const dvm_model *m)
+{
+    double hz = m->period_ns ? 1e9 / (double)m->period_ns : 0;
+    if (m->state == DVM_VRR)
+        fprintf(stderr, "[PACING] display: variable refresh (%.2f Hz mode, its refreshes follow"
+                " our presents: median step %.2f ms): the vblank runs on its own 60.000 Hz"
+                " timer\n", hz, m->median_ns / 1e6);
+    else if (m->state == DVM_FIXED && m->period_ns)
+        fprintf(stderr, "[PACING] display: fixed refresh %.3f Hz (median step %.2f ms)\n",
+                hz, m->median_ns / 1e6);
+}
+
+static DWORD WINAPI vblank_main(LPVOID param)
+{
+    IDXGIOutput *out = (IDXGIOutput *)param;
+    HMONITOR mon = NULL;
+    dvm_model *m = (dvm_model *)calloc(1, sizeof *m);
+    uint64_t last = 0, look = 0;
+    unsigned fails = 0, fast = 0;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    if (!m) {
+        IDXGIOutput_Release(out);
+        return 0;
+    }
+    dvm_reset(m, 0, 0);
+    m->period_ns = ~0ull;                       /* read at the first look */
+    while (InterlockedCompareExchange(&s_run, 1, 1)) {
+        uint64_t t, when, per;
+        int r;
+        /* Once a second, and after a failed wait: the window's monitor and
+         * its mode. A new output or a new rate starts the model over. */
+        t = mono_ns();
+        if (!look || t - look >= 1000000000ull || fails) {
+            HMONITOR now_mon = MonitorFromWindow(s_hwnd, MONITOR_DEFAULTTONEAREST);
+            int exact;
+            unsigned num, den;
+            uint64_t p;
+            look = t;
+            if (now_mon && now_mon != mon) {
+                IDXGIOutput *o2 = output_for(now_mon);
+                if (o2) {
+                    if (mon)
+                        fprintf(stderr, "[PACING] display: the window moved to another"
+                                " monitor; the vblank follows that one\n");
+                    IDXGIOutput_Release(out);
+                    out = o2;
+                    mon = now_mon;
+                    m->period_ns = ~0ull;
+                }
+            }
+            p = mode_period(mon, &exact, &num, &den);
+            if (p != m->period_ns || exact != m->exact) {
+                fprintf(stderr, "[PACING] display mode: %.3f Hz (%u/%u%s)\n",
+                        p ? 1e9 / (double)p : 0.0, num, den,
+                        exact ? ", QueryDisplayConfig" : p ? ", whole Hz only" : ", unknown");
+                dvm_reset(m, p, exact);
+                InterlockedExchange(&s_state, DVM_UNKNOWN);
+                last = 0;
+            }
+            InterlockedExchange64(&s_period_ns, (LONGLONG)m->period_ns);
+            InterlockedExchange(&s_exact, m->exact);
+        }
+        if (FAILED(IDXGIOutput_WaitForVBlank(out))) {
+            /* A lost output (mode change, display off): back off, never spin.
+             * Eight in a row and it is gone (a TV switched off and on, a
+             * driver reset): find the window's output afresh at the next
+             * look, and say nothing is known meanwhile -- the old rate and
+             * kind held the presenter in a lock the grid no longer had. */
+            Sleep(fails < 8 ? 16 : 250);
+            if (++fails == 8) {
+                mon = NULL;
+                InterlockedExchange64(&s_period_ns, 0);
+                InterlockedExchange(&s_state, DVM_UNKNOWN);
+            }
+            continue;
+        }
+        fails = 0;
+        t = mono_ns();
+        /* An output that is asleep answers at once, with success; no refresh
+         * comes within half a millisecond of the last: three in a row is not
+         * a display, so nothing is reported and the thread sleeps as for a
+         * lost output, until a wait takes its time again. */
+        if (last && t - last < 500000ull) {
+            if (++fast >= 3) {
+                Sleep(fast < 64 ? 16 : 250);
+                last = mono_ns();
+                continue;
+            }
+        } else {
+            fast = 0;
+        }
+        last = t;
+        r = dvm_refresh(m, t, &when, &per);
+        InterlockedExchange(&s_state, m->state);
+        if (r & DVM_CHANGED)
+            say_state(m);
+        /* RECOMP_PRESENT_TIMING=timed (the launcher's "variable refresh"):
+         * the refreshes are our own presents at any rate, so they are not
+         * fed to the grid -- at a 60 Hz mode they look like a fixed 60 Hz
+         * display and the grid chased its own presents. */
+        if ((r & DVM_REPORT) && s_report)
+            xbox_VblankDisplayRefresh((double)when / 1e6, (double)per / 1e6);
+    }
+    free(m);
+    IDXGIOutput_Release(out);
+    return 0;
+}
+
+void xbox_DxgiVblankStart(HWND hwnd)
+{
+    HMODULE dll;
+    IDXGIOutput *found;
+    HANDLE th;
+    const char *e = getenv("RECOMP_VBLANK_SYNC");
+
+    if (!e || strcmp(e, "display") || InterlockedCompareExchange(&s_run, 0, 0))
+        return;
+    {
+        const char *t = getenv("RECOMP_PRESENT_TIMING");
+        s_report = !(t && !strcmp(t, "timed"));
+    }
+    dll = LoadLibraryA("dxgi.dll");
+    s_create = dll ? (dxgi_create_fn)(void (*)(void))GetProcAddress(dll, "CreateDXGIFactory1")
+                   : NULL;
+    if (!s_create) {
+        fprintf(stderr, "[PACING] vblank sync: no DXGI; the vblank keeps its own 60 Hz timer\n");
+        return;
+    }
+    s_hwnd = hwnd;
+    found = output_for(MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST));
+    if (!found) {
+        fprintf(stderr, "[PACING] vblank sync: the window's monitor has no DXGI output; the"
+                " vblank keeps its own 60 Hz timer\n");
+        return;
+    }
+    InterlockedExchange(&s_run, 1);
+    th = CreateThread(NULL, 0, vblank_main, found, 0, NULL);
+    if (!th) {
+        InterlockedExchange(&s_run, 0);
+        IDXGIOutput_Release(found);
+        return;
+    }
+    CloseHandle(th);
+    fprintf(stderr, "[PACING] vblank sync: the emulated vblank follows the window's display"
+            " on a fixed-rate 60/120/240 Hz mode, and its own 60 Hz under variable refresh"
+            " (DXGI WaitForVBlank)\n");
+}
+
+void xbox_DxgiVblankStop(void)
+{
+    InterlockedExchange(&s_run, 0);
+}
+
+int xbox_DxgiVblankDisplay(double *hz, int *exact, int *vrr)
+{
+    LONGLONG p = InterlockedCompareExchange64(&s_period_ns, 0, 0);
+    LONG st = InterlockedCompareExchange(&s_state, 0, 0);
+    if (!InterlockedCompareExchange(&s_run, 1, 1) || p <= 0 || p == (LONGLONG)~0ull)
+        return 0;
+    *hz = 1e9 / (double)p;
+    *exact = (int)InterlockedCompareExchange(&s_exact, 0, 0);
+    *vrr = st == DVM_VRR ? 1 : st == DVM_FIXED ? 0 : -1;
+    return 1;
+}
+#endif
diff --git a/src/video/dxgi_vblank.h b/src/video/dxgi_vblank.h
new file mode 100644
index 0000000..ea71cfe
--- /dev/null
+++ b/src/video/dxgi_vblank.h
@@ -0,0 +1,15 @@
+/* dxgi_vblank.c: follow the display the game window is on (Windows). */
+#ifndef XBOX_DXGI_VBLANK_H
+#define XBOX_DXGI_VBLANK_H
+#if defined(_WIN32)
+#include <windows.h>
+
+/* Start the vblank thread for hwnd's display (RECOMP_VBLANK_SYNC=display). */
+void xbox_DxgiVblankStart(HWND hwnd);
+void xbox_DxgiVblankStop(void);
+/* The window's display: its mode's rate, whether that rate is exact, and
+ * whether it refreshes at our presents (1 VRR, 0 fixed, -1 not known yet).
+ * 0 when the thread does not run or knows no rate. */
+int  xbox_DxgiVblankDisplay(double *hz, int *exact, int *vrr);
+#endif
+#endif
diff --git a/src/video/dxgi_vblank_model.h b/src/video/dxgi_vblank_model.h
new file mode 100644
index 0000000..4984047
--- /dev/null
+++ b/src/video/dxgi_vblank_model.h
@@ -0,0 +1,190 @@
+/* Ported from xenophobentx/xboxrecomp (branch takedawn, MIT), 2026-10-26.
+ *
+ * dxgi_vblank_model.h - Windows: what the DXGI vblank thread
+ * (fb_present_vulkan.c) makes of IDXGIOutput::WaitForVBlank (BO-191).
+ *
+ * RECOMP_VBLANK_SYNC=display moves the emulated 60 Hz vblank onto the
+ * display's refresh grid (kernel_pacing.c). The grid comes from a thread
+ * that waits for each vertical blank of the window's output. Two things
+ * about those returns:
+ *
+ *  - On a fixed-rate display the thread returns at every refresh, whether
+ *    the title presents or not: 4.167 ms steps at 240 Hz. Under variable
+ *    refresh (G-Sync, FreeSync) the display refreshes when a frame arrives,
+ *    so the thread returns at our own presents (16.7 ms at 60 fps), or at
+ *    the panel's self-refresh floor when none comes. Locked to those, the
+ *    vblank chases its own presents: each report is a present plus its
+ *    latency, the lock re-anchors on it, and the vblank intervals swing
+ *    8.6-22.7 ms (GitHub issue #4). So: the median step over the last half
+ *    second longer than 1.5 stated periods is variable refresh; held for a
+ *    second it changes the state. Under variable refresh nothing is
+ *    reported: the lock stands down (no report for 250 ms) and the vblank
+ *    runs on its own 60.000 Hz timer, which the display then follows.
+ *
+ *  - A return is the thread's wake-up after the refresh, up to a
+ *    millisecond late on a busy PC. Snapped to each raw return, the grid
+ *    carried that jitter into every vblank edge (p99 17.5 ms at a fixed
+ *    240 Hz). With the mode's stated period (QueryDisplayConfig, an exact
+ *    rational: 60000/1001 for 59.94) the grid is a filtered phase instead:
+ *    each return moves it 1/32 of the way, by at most an eighth of a
+ *    period, and the reports are points on that grid, carrying the stated
+ *    period. Their steps are whole periods, so the kernel's irregular-step
+ *    guard never stands the lock down on wake-up jitter.
+ *
+ * Pure arithmetic on host nanoseconds, no platform call: the thread feeds
+ * it, tests/vblank_schedule drives it. Only the Windows build uses it.
+ */
+#ifndef DXGI_VBLANK_MODEL_H
+#define DXGI_VBLANK_MODEL_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define DVM_STEPS     256                 /* half a second at up to 500 Hz */
+#define DVM_WINDOW_NS 500000000ull        /* the steps the median is over */
+#define DVM_HOLD_NS   1000000000ull       /* how long a new state must hold */
+#define DVM_MIN_STEPS 8
+#define DVM_BREAK_NS  100000000ull        /* a longer step is a break, not a refresh */
+#define DVM_GAIN      32                  /* the phase filter: 1/32 of each error */
+
+enum { DVM_UNKNOWN = -1, DVM_FIXED = 0, DVM_VRR = 1 };
+
+/* dvm_refresh's result bits. */
+#define DVM_REPORT  1                     /* report *when to the vblank lock */
+#define DVM_CHANGED 2                     /* the state changed (log it) */
+
+typedef struct {
+    uint64_t period_ns;   /* the mode's refresh period; 0 unknown */
+    int      exact;       /* period_ns is the mode's rational, not a whole-Hz rate */
+    int      state;       /* DVM_UNKNOWN until half a second of steps */
+    uint64_t first_ns;    /* the first return since the reset */
+    uint64_t last_ns;     /* the last return */
+    uint64_t grid_ns;     /* the filtered refresh; 0 none */
+    int      off;         /* returns in a row far off the grid */
+    uint64_t step_at[DVM_STEPS];
+    uint32_t step_ns[DVM_STEPS];
+    unsigned pos, n;
+    int      pending;     /* the other state the steps show */
+    uint64_t pending_ns;  /* since when */
+    uint32_t median_ns;   /* the last window's median step */
+} dvm_model;
+
+/* A new output or mode: forget everything. */
+static inline void dvm_reset(dvm_model *m, uint64_t period_ns, int exact)
+{
+    memset(m, 0, sizeof *m);
+    m->period_ns = period_ns;
+    m->exact = exact && period_ns;
+    m->state = DVM_UNKNOWN;
+    m->pending = DVM_UNKNOWN;
+}
+
+/* The median of the steps that ended in the last DVM_WINDOW_NS; 0 when
+ * fewer than DVM_MIN_STEPS. */
+static inline uint32_t dvm_median(const dvm_model *m, uint64_t now_ns)
+{
+    uint32_t v[DVM_STEPS];
+    unsigned i, k = 0, j;
+
+    for (i = 0; i < m->n; i++) {
+        unsigned at = (m->pos + DVM_STEPS - 1 - i) % DVM_STEPS;
+        if (now_ns - m->step_at[at] > DVM_WINDOW_NS)
+            break;
+        /* insertion sort: at most a few hundred, once per return */
+        for (j = k; j > 0 && v[j - 1] > m->step_ns[at]; j--)
+            v[j] = v[j - 1];
+        v[j] = m->step_ns[at];
+        k++;
+    }
+    return k < DVM_MIN_STEPS ? 0 : v[k / 2];
+}
+
+/* One WaitForVBlank return at t_ns. Returns DVM_* bits; with DVM_REPORT,
+ * *when_ns is the refresh to report and *period_ns its period (0 when the
+ * period is not exact: the kernel measures it from the steps, as before). */
+static inline int dvm_refresh(dvm_model *m, uint64_t t_ns, uint64_t *when_ns,
+                              uint64_t *period_ns)
+{
+    const uint64_t p = m->period_ns;
+    int res = 0, meas;
+
+    if (!m->first_ns)
+        m->first_ns = t_ns;
+    if (m->last_ns && t_ns > m->last_ns && t_ns - m->last_ns <= DVM_BREAK_NS) {
+        m->step_at[m->pos] = t_ns;
+        m->step_ns[m->pos] = (uint32_t)(t_ns - m->last_ns);
+        m->pos = (m->pos + 1) % DVM_STEPS;
+        if (m->n < DVM_STEPS)
+            m->n++;
+    }
+    m->last_ns = t_ns;
+
+    /* The detector. Unknown period: the old behaviour, a fixed display
+     * whose period the kernel measures. */
+    if (!p) {
+        meas = DVM_FIXED;
+    } else {
+        m->median_ns = dvm_median(m, t_ns);
+        if (!m->median_ns || t_ns - m->first_ns < DVM_WINDOW_NS * 4 / 5)
+            meas = m->state;            /* not enough seen yet */
+        else
+            meas = (uint64_t)m->median_ns * 2 > p * 3 ? DVM_VRR : DVM_FIXED;
+    }
+    if (meas != DVM_UNKNOWN && meas != m->state) {
+        if (m->state == DVM_UNKNOWN) {
+            m->state = meas;
+            res |= DVM_CHANGED;
+        } else if (m->pending != meas) {
+            m->pending = meas;
+            m->pending_ns = t_ns;
+        } else if (t_ns - m->pending_ns >= DVM_HOLD_NS) {
+            m->state = meas;
+            m->pending = DVM_UNKNOWN;
+            res |= DVM_CHANGED;
+        }
+    } else {
+        m->pending = DVM_UNKNOWN;
+    }
+    if (res & DVM_CHANGED)
+        m->grid_ns = 0;                 /* a fresh phase on the new state */
+
+    if (m->state != DVM_FIXED)
+        return res;
+    if (!m->exact) {
+        *when_ns = t_ns;
+        *period_ns = 0;
+        return res | DVM_REPORT;
+    }
+
+    /* The phase filter. */
+    if (!m->grid_ns || t_ns <= m->grid_ns || t_ns - m->grid_ns > DVM_BREAK_NS) {
+        m->grid_ns = t_ns;
+        m->off = 0;
+    } else {
+        uint64_t k = (t_ns - m->grid_ns + p / 2) / p;
+        uint64_t pred = m->grid_ns + k * p;
+        int64_t r = (int64_t)(t_ns - pred), lim = (int64_t)(p / 8);
+        if (r > (int64_t)(p / 4) || r < -(int64_t)(p / 4)) {
+            /* Far off: a late wake once in a while, but a run of them is a
+             * grid that moved (a stated period that no longer holds). */
+            if (++m->off >= 8) {
+                m->grid_ns = t_ns;
+                m->off = 0;
+                goto report;
+            }
+        } else {
+            m->off = 0;
+        }
+        if (r > lim)
+            r = lim;
+        else if (r < -lim)
+            r = -lim;
+        m->grid_ns = pred + r / DVM_GAIN;
+    }
+report:
+    *when_ns = m->grid_ns;
+    *period_ns = p;
+    return res | DVM_REPORT;
+}
+
+#endif
diff --git a/src/video/fb_gamma.c b/src/video/fb_gamma.c
new file mode 100644
index 0000000..165eab0
--- /dev/null
+++ b/src/video/fb_gamma.c
@@ -0,0 +1,76 @@
+/* The display's gamma ramp.
+ *
+ * Xbox D3D (SetGammaRamp; SSX 3's sub_00239B76) loads 256 R, G and B entries
+ * into the NV2A's VGA palette (PRMDIO 0x6813C8 index, 0x6813C9 data, three
+ * writes per entry), and the RAMDAC looks every scanned-out pixel up in it.
+ * The emulated MMIO keeps no such table, so a title calls
+ * xbox_FramebufferSetGammaRamp with the ramp it uploads and the presenters
+ * apply it to the finished frame -- without it the picture is shown with a
+ * linear ramp, lighter and flatter than on the console.
+ * RECOMP_GAMMA=0 ignores the title's ramp. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint8_t s_lut[3][256];
+static volatile int s_lut_on;
+static volatile unsigned s_lut_serial;     /* +1 per change, for the GPU presenter */
+
+void xbox_FramebufferSetGammaRamp(const uint8_t *r, const uint8_t *g, const uint8_t *b)
+{
+    static int allowed = -1, said;
+    int i, identity = 1;
+    if (allowed < 0) {
+        const char *e = getenv("RECOMP_GAMMA");
+        allowed = !(e && *e == '0');
+    }
+    for (i = 0; i < 256; i++)
+        if (r[i] != i || g[i] != i || b[i] != i)
+            identity = 0;
+    if (!allowed || identity) {
+        s_lut_on = 0;
+        s_lut_serial++;
+        return;
+    }
+    memcpy(s_lut[0], r, 256);
+    memcpy(s_lut[1], g, 256);
+    memcpy(s_lut[2], b, 256);
+    s_lut_on = 1;
+    s_lut_serial++;
+    if (said < 4) {
+        said++;
+        fprintf(stderr, "[GAMMA] ramp loaded: r 0->%u 64->%u 128->%u 192->%u 255->%u"
+                " (g 128->%u, b 128->%u)\n", r[0], r[64], r[128], r[192], r[255], g[128], b[128]);
+    }
+}
+
+/* Apply the ramp to n X8R8G8B8 pixels in place (no-op without one). */
+void xbox_FramebufferApplyGamma(uint32_t *px, size_t n)
+{
+    size_t i;
+    if (!s_lut_on)
+        return;
+    for (i = 0; i < n; i++) {
+        uint32_t c = px[i];
+        px[i] = (c & 0xFF000000u) | ((uint32_t)s_lut[0][(c >> 16) & 0xFF] << 16)
+              | ((uint32_t)s_lut[1][(c >> 8) & 0xFF] << 8) | s_lut[2][c & 0xFF];
+    }
+}
+
+/* The ramp as 256 B8G8R8A8 texels (identity without one), for a presenter
+ * that applies it on the GPU; returns its change serial. */
+unsigned xbox_FramebufferGammaTexels(uint32_t *out256)
+{
+    int i;
+    for (i = 0; i < 256; i++)
+        out256[i] = s_lut_on ? 0xFF000000u | (uint32_t)s_lut[0][i] << 16
+                               | (uint32_t)s_lut[1][i] << 8 | s_lut[2][i]
+                             : 0xFF000000u | (uint32_t)i * 0x010101u;
+    return s_lut_serial;
+}
+
+unsigned xbox_FramebufferGammaSerial(void)
+{
+    return s_lut_serial;
+}
