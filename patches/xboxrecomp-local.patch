diff --git a/src/video/vbl_fifo.h b/src/video/vbl_fifo.h
new file mode 100644
index 0000000..8052a94
--- /dev/null
+++ b/src/video/vbl_fifo.h
@@ -0,0 +1,57 @@
+/*
+ * vbl_fifo.h - each frame's emulated vblank on its way to the presenter
+ * (fb_present.c). The title's port pushes, once per present on its own
+ * thread, the vblank of the tick the frame was rendered for; the backend
+ * pops one per flip. A present that makes no flip leaves an extra entry
+ * behind, and every later frame was then tagged with an older vblank (45 ms
+ * instead of 11-15: every frame "late" for its present, shown on arrival
+ * with its jitter). So the pop skips entries more than max_age old while a
+ * newer one waits. One producer, one consumer: a full FIFO drops the new
+ * entry, an empty one gives 0.
+ */
+#ifndef XBOX_VBL_FIFO_H
+#define XBOX_VBL_FIFO_H
+
+#define VBL_FIFO_N 16
+
+typedef struct {
+    double v[VBL_FIFO_N];
+    volatile long head, tail;
+} vbl_fifo;
+
+static inline void vbl_fifo_init(vbl_fifo *f) { f->head = f->tail = 0; }
+
+#if defined(_MSC_VER)
+#include <intrin.h>
+#define VBL_FENCE() _ReadWriteBarrier()
+#else
+#define VBL_FENCE() __atomic_thread_fence(__ATOMIC_SEQ_CST)
+#endif
+
+static inline void vbl_fifo_push(vbl_fifo *f, double ms)
+{
+    long t = f->tail;
+    if (t - f->head >= VBL_FIFO_N)
+        return;
+    f->v[t % VBL_FIFO_N] = ms;
+    VBL_FENCE();
+    f->tail = t + 1;
+}
+
+static inline double vbl_fifo_pop(vbl_fifo *f, double now_ms, double max_age_ms)
+{
+    long h = f->head, t = f->tail;
+    double v;
+    VBL_FENCE();
+    if (h == t)
+        return 0.0;
+    /* skip what is too old while a newer entry waits */
+    while (t - h > 1 && now_ms - f->v[h % VBL_FIFO_N] > max_age_ms)
+        h++;
+    v = f->v[h % VBL_FIFO_N];
+    VBL_FENCE();
+    f->head = h + 1;
+    return v;
+}
+
+#endif
