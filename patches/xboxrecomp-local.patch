+/* Frame pacing (RECOMP_PRESENT_TIMING=auto; legacy = present when ready).
+ * The strategy follows the window's display (dxgi_vblank.c), re-checked
+ * twice a second (present_cadence.h):
+ *   lock       fixed 60/120/240 Hz: the vblank grid is locked to the
+ *              display; each frame is presented for its own refresh;
+ *   timed      variable refresh (or nothing known): each frame at its
+ *              vblank + 12 ms, so the frames reach the display 1/60 s apart
+ *              and a VRR display refreshes evenly at their rate;
+ *   timed-odd  fixed, not a multiple of 60 (144, 165 Hz): as timed; even
+ *              cadence is impossible there and the log and overlay say so.
+ * On-glass times (GetFrameStatistics) are fed back to the pacer, which
+ * raises its depth or lead when frames miss. Flip model only. */
+static void pacing_probe(uint64_t now)
+{
+    pc_display d;
+    double hz = 0.0;
+    int exact = 0, vrr = -1, strat;
+    if (s_pstrat >= 0 && now < s_pprobe)
+        return;
+    s_pprobe = now + 500000000ull;
+    memset(&d, 0, sizeof d);
+    if (gpu_present_flip_model() && xbox_DxgiVblankDisplay(&hz, &exact, &vrr) && vrr >= 0) {
+        d.refresh_hz = hz;
+        d.vrr = vrr == 1;
+        d.min_hz = d.vrr ? 48.0 : hz;
+    }   /* fixed or variable not known yet: no rate, so timed (never a lock on a guess) */
+    strat = gpu_present_flip_model() ? pc_pick(&d, pc_setting(getenv("RECOMP_PRESENT_TIMING")))
+                                     : PC_LEGACY;
+    if (strat == s_pstrat && vrr == s_pvrr && (int)(hz * 100.0) == (int)(s_phz * 100.0))
+        return;
+    s_pstrat = strat; s_pvrr = vrr; s_phz = hz;
+    pc_pacer_init(&s_pacer, strat, &d, 5000000ull, 12000000ull, 1);
+    s_g_slips0 = s_g_lates0 = 0;
+    fprintf(stderr, "[PACING] presenting: %s (display %.2f Hz, %s)\n", pc_strategy_name(strat), hz,
+            vrr == 1 ? "variable refresh" : vrr == 0 ? "fixed refresh" : "refresh kind not known yet");
+    s_odd_since = strat == PC_TIMED_ODD && vrr == 0 ? now : 0;
+}
+
+/* The uneven-rate warning, once the display has been fixed-rate (no VRR)
+ * for 20 s: a G-Sync/FreeSync display reads as fixed until it takes the
+ * game's presents -- in a menu, behind another window -- and was warned
+ * about at start. */
+static int pacing_uneven_now(uint64_t now)
+{
+    if (!s_odd_since || now - s_odd_since < 20000000000ull)
+        return 0;
+    if (!s_odd_warned) {
+        s_odd_warned = 1;
+        fprintf(stderr, "[PACING] %.0f Hz display without VRR: 60 FPS cannot be shown evenly."
+                " Turn on G-Sync/FreeSync, or use 60/120/240 Hz.\n", s_phz);
+    }
+    return 1;
+}
