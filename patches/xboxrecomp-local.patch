+/* Frames published as shared textures (the renderer copied them on the GPU,
+ * gpu_present.c): a queue the window thread empties, showing the newest
+ * and handing the others back. */
+typedef struct { int tex; uint32_t w, h; double vbl; uint64_t arr; } ShFrame;
+#define SHQ 8
+static ShFrame       s_shq[SHQ];
+static volatile LONG s_shq_head, s_shq_tail, s_sh_tick;
+
+void xbox_FramebufferPublishShared(int tex, uint32_t w, uint32_t h, double vblank_ms)
+{
+    LONG t = s_shq_tail;
+    ShFrame *f = &s_shq[t % SHQ];
+    f->tex = tex; f->w = w; f->h = h; f->vbl = vblank_ms;
+    f->arr = gpu_present_now_ns();
+    InterlockedExchange(&s_shq_tail, t + 1);
+    InterlockedExchange(&s_sh_tick, (LONG)GetTickCount());
+    if (s_hi_event)
+        SetEvent(s_hi_event);
+}
+
+int xbox_FramebufferSharedMake(uint32_t w, uint32_t h, void *handles[4], uint8_t luid[8])
+{
+    if (!gpu_present_active())
+        return 0;
+    /* Frames queued for the old textures are not shown (their indices name
+     * the new ones, which no frame has been copied into yet). */
+    InterlockedExchange(&s_shq_head, InterlockedCompareExchange(&s_shq_tail, 0, 0));
+    return gpu_present_shared_make(w, h, handles, luid);
+}
