diff --git a/tests/dxgi_vblank_model/test_main.c b/tests/dxgi_vblank_model/test_main.c
new file mode 100644
index 0000000..d7f80a6
--- /dev/null
+++ b/tests/dxgi_vblank_model/test_main.c
@@ -0,0 +1,94 @@
+/*
+ * dxgi_vblank_model test: what the DXGI vblank thread makes of
+ * IDXGIOutput::WaitForVBlank returns (src/video/dxgi_vblank_model.h).
+ * Each case feeds return times straight to dvm_refresh.
+ */
+#include "dxgi_vblank_model.h"
+#include <stdio.h>
+
+#define MS 1000000ull
+
+static int s_fail;
+
+static void check(int ok, const char *what)
+{
+    printf("  %s  %s\n", ok ? "ok  " : "FAIL", what);
+    if (!ok)
+        s_fail = 1;
+}
+
+/* Feed returns every step_ns for secs seconds; count the reports. */
+static int feed(dvm_model *m, uint64_t *t, uint64_t step_ns, double secs)
+{
+    uint64_t end = *t + (uint64_t)(secs * 1e9), w, p;
+    int reports = 0;
+    while (*t < end) {
+        *t += step_ns;
+        if (dvm_refresh(m, *t, &w, &p) & DVM_REPORT)
+            reports++;
+    }
+    return reports;
+}
+
+static void fixed_144_is_fixed(void)
+{
+    dvm_model m;
+    uint64_t t = 1000 * MS, period = 1000000000ull / 144;
+    int n;
+    dvm_reset(&m, period, 1);
+    n = feed(&m, &t, period, 2.0);
+    check(m.state == DVM_FIXED, "fixed 144 Hz: every refresh returns -> fixed");
+    check(n > 144, "fixed 144 Hz: refreshes are reported");
+}
+
+static void vrr_returns_at_presents(void)
+{
+    dvm_model m;
+    uint64_t t = 1000 * MS, period = 1000000000ull / 144;
+    int n;
+    dvm_reset(&m, period, 1);
+    n = feed(&m, &t, 1000000000ull / 60, 2.0);
+    check(m.state == DVM_VRR, "VRR at 144 Hz: returns at our 60 fps presents -> VRR");
+    (void)n;
+    n = feed(&m, &t, 1000000000ull / 60, 1.0);
+    check(n == 0, "VRR: nothing is reported (the grid runs on its own)");
+}
+
+/* Wake-ups 0..1 ms late at a fixed 120 Hz: the reports stay on the
+ * refresh grid (every report a whole number of periods from the first,
+ * within 0.2 ms), not on the raw returns. */
+static void jitter_is_filtered(void)
+{
+    dvm_model m;
+    const uint64_t period = 1000000000ull / 120;
+    uint64_t grid = 1000 * MS, t, w, p, first = 0;
+    unsigned rng = 7;
+    int i, off = 0, reports = 0;
+    dvm_reset(&m, period, 1);
+    for (i = 0; i < 1200; i++) {               /* 10 s */
+        grid += period;
+        rng = rng * 1103515245u + 12345u;
+        t = grid + (uint64_t)((rng >> 8) % 1000u) * 1000u;
+        if (!(dvm_refresh(&m, t, &w, &p) & DVM_REPORT) || i < 240)
+            continue;
+        if (!first)
+            first = w;
+        reports++;
+        {
+            uint64_t d = (w - first) % period;
+            if (d > 200000u && d < period - 200000u)
+                off++;
+        }
+    }
+    check(reports > 900 && off == 0, "fixed 120 Hz with 0-1 ms late wakes: reports stay on the grid");
+}
+
+int main(void)
+{
+    printf("dxgi_vblank_model\n");
+    fixed_144_is_fixed();
+    vrr_returns_at_presents();
+    jitter_is_filtered();
+    printf(s_fail ? "FAILED\n" : "all passed\n");
+    return s_fail;
+}
