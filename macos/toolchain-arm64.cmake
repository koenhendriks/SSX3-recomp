# Cross toolchain: Linux (Docker) -> macOS arm64, clang + ld64.lld, SDK copied to <parent>/deps/sdk/MacOSX.sdk (macos/setup.sh), seen as /work in Docker.
set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_SYSTEM_VERSION 23.0)
set(_CURRENT_OSX_VERSION 14.0)
set(CMAKE_OSX_ARCHITECTURES arm64)
set(CMAKE_OSX_SYSROOT /work/deps/sdk/MacOSX.sdk)
set(CMAKE_OSX_DEPLOYMENT_TARGET 14.0)
set(TRIPLE arm64-apple-macos14.0)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET ${TRIPLE})
set(CMAKE_CXX_COMPILER_TARGET ${TRIPLE})
set(CMAKE_AR /usr/local/bin/llvm-ar)
set(CMAKE_RANLIB /usr/local/bin/llvm-ranlib)
set(CMAKE_INSTALL_NAME_TOOL /usr/local/bin/llvm-install-name-tool)
set(CMAKE_LINKER_TYPE LLD)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -Wl,-rpath,@executable_path")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_FIND_ROOT_PATH /work/deps/sdk/MacOSX.sdk /work/deps/prefix-arm64 /work/deps/sdl2-static)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# CMake's Darwin platform file only sets these when it can query the host's macOS version.
set(CMAKE_SHARED_LIBRARY_RUNTIME_C_FLAG "-Wl,-rpath,")
set(CMAKE_SHARED_LIBRARY_RUNTIME_C_FLAG_SEP ";")
set(CMAKE_SHARED_LIBRARY_RUNTIME_CXX_FLAG "-Wl,-rpath,")
set(CMAKE_SHARED_LIBRARY_RUNTIME_CXX_FLAG_SEP ";")
set(CMAKE_OBJC_COMPILER clang)
set(CMAKE_OBJC_COMPILER_TARGET ${TRIPLE})
